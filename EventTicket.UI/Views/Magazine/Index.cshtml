@model List<EventTicket.UI.ViewModels.ArticleViewModel>
@{
    ViewData["Title"] = "Magazin";
    var hero = Model.Take(1).ToList();
    var rest = Model.Skip(1).ToList();
}

<div style="max-width:1280px;margin:0 auto;padding:40px 20px">

    @if (!Model.Any())
    {
        <div style="text-align:center;padding:80px 20px;color:rgba(255,255,255,0.3)">
            <i class="bi bi-newspaper" style="font-size:48px;display:block;margin-bottom:16px"></i>
            <div style="font-size:16px">Henüz yayınlanmış haber yok.</div>
        </div>
    }
    else
    {
        @* HERO *@
        @if (hero.Any())
        {
            var h = hero[0];
            <a href="/Magazine/Details/@h.Slug" style="text-decoration:none;display:block;margin-bottom:48px">
                <div style="position:relative;height:480px;border-radius:20px;overflow:hidden;background:#111">
                    @if (!string.IsNullOrEmpty(h.ImageUrl))
                    {
                        <img src="@h.ImageUrl" alt="@h.Title" style="width:100%;height:100%;object-fit:cover;opacity:0.6" />
                    }
                    <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,0.92) 0%,transparent 60%)"></div>
                    <div style="position:absolute;bottom:0;left:0;padding:40px 48px;max-width:700px">
                        <span style="background:#fff;color:#000;font-size:10px;font-weight:800;letter-spacing:.1em;padding:4px 12px;border-radius:100px;text-transform:uppercase;margin-bottom:14px;display:inline-block">@h.Tag</span>
                        <div style="font-size:36px;font-weight:900;color:#fff;line-height:1.1;margin-bottom:12px;letter-spacing:-0.02em">@h.Title</div>
                        <div style="font-size:14px;color:rgba(255,255,255,0.55);line-height:1.6;margin-bottom:16px">@h.Summary</div>
                        <div style="font-size:12px;color:rgba(255,255,255,0.35)">
                            @h.Author &nbsp;·&nbsp; @h.ReadTime dk okuma &nbsp;·&nbsp; @h.CreatedAt.ToString("dd MMM yyyy")
                        </div>
                    </div>
                </div>
            </a>
        }

        @* GRID *@
        @if (rest.Any())
        {
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:24px">
                @foreach (var a in rest)
                {
                    <a href="/Magazine/Details/@a.Slug" style="text-decoration:none">
                        <div style="background:#111;border:1px solid rgba(255,255,255,0.07);border-radius:16px;overflow:hidden;transition:transform 0.2s,border-color 0.2s"
                             onmouseover="this.style.transform='translateY(-4px)';this.style.borderColor='rgba(255,255,255,0.16)'"
                             onmouseout="this.style.transform='';this.style.borderColor='rgba(255,255,255,0.07)'">
                            @if (!string.IsNullOrEmpty(a.ImageUrl))
                            {
                                <img src="@a.ImageUrl" alt="@a.Title" style="width:100%;height:200px;object-fit:cover" />
                            }
                            else
                            {
                                <div style="width:100%;height:200px;background:#1a1a1a;display:flex;align-items:center;justify-content:center">
                                    <i class="bi bi-newspaper" style="font-size:32px;color:rgba(255,255,255,0.15)"></i>
                                </div>
                            }
                            <div style="padding:18px 20px">
                                <span style="background:rgba(255,255,255,0.08);color:rgba(255,255,255,0.6);font-size:10px;font-weight:700;letter-spacing:.08em;padding:3px 10px;border-radius:100px;text-transform:uppercase">@a.Tag</span>
                                <div style="font-size:15px;font-weight:700;color:#fff;margin:10px 0 8px;line-height:1.35">@a.Title</div>
                                <div style="font-size:12px;color:rgba(255,255,255,0.4);line-height:1.6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">@a.Summary</div>
                                <div style="margin-top:14px;font-size:11px;color:rgba(255,255,255,0.3)">
                                    @a.Author &nbsp;·&nbsp; @a.ReadTime dk
                                </div>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    }
</div>
