                    <div class="mag-card-meta">
                        <i class="bi bi-calendar3"></i> 3 Nisan 2026
                        <span>·</span>
                        <i class="bi bi-clock"></i> 5 dk okuma
                    </div>
                </div>
            </a>
            <!-- Yan haberler -->
            <a asp-controller="Magazine" asp-action="Details" asp-route-slug="hero-2" class="mag-hero-side" style="text-decoration:none">
                <img src="https://cdn.bugece.co/cfe72717-fc72-416c-a348-3531651b9f11" alt="I Hate Models İstanbul" />
                <div class="mag-card-overlay">
                    <span class="mag-card-tag">Festival</span>
                    <div class="mag-card-title">I Hate Models — Disco Inferno ile İstanbul'u Yakacak</div>
                    <div class="mag-card-meta"><i class="bi bi-calendar3"></i> 1 Nisan 2026</div>
                </div>
            </a>
            <a asp-controller="Magazine" asp-action="Details" asp-route-slug="hero-3" class="mag-hero-side" style="text-decoration:none">
                <img src="https://cdn.bugece.co/77724539-d7a1-4999-9e1e-50fe62c951ba" alt="ZAMNA Bodrum" />
                <div class="mag-card-overlay">
                    <span class="mag-card-tag">Haber</span>
                    <div class="mag-card-title">ZAMNA x MO Homecoming: Life Park'ta Tarihi Gece</div>
                    <div class="mag-card-meta"><i class="bi bi-calendar3"></i> 31 Mart 2026</div>
                </div>
            </a>
