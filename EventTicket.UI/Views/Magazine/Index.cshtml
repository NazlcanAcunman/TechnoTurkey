@{
    ViewData["Title"] = "Magazin";
}

<style>
    .mag-wrap {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px 80px;
    }

    .mag-hero {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 48px;
    }

    .mag-hero-main {
        grid-row: span 2;
        border-radius: 16px;
        overflow: hidden;
        position: relative;
        background: #0d0d0d;
        cursor: pointer;
        transition: transform 0.3s;
    }

    .mag-hero-main:hover { transform: translateY(-4px); }

    .mag-hero-main img {
        width: 100%;
        height: 480px;
        object-fit: cover;
        display: block;
    }

    .mag-hero-side {
        border-radius: 14px;
        overflow: hidden;
        position: relative;
        background: #0d0d0d;
        cursor: pointer;
        transition: transform 0.3s;
    }

    .mag-hero-side:hover { transform: translateY(-3px); }

    .mag-hero-side img {
        width: 100%;
        height: 220px;
        object-fit: cover;
        display: block;
    }

    .mag-card-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 24px 20px 20px;
        background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0) 100%);
    }

    .mag-card-tag {
        display: inline-block;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.12em;
        color: #000;
        background: #fff;
        padding: 3px 8px;
        border-radius: 100px;
        margin-bottom: 8px;
        text-transform: uppercase;
    }

    .mag-card-title {
        font-size: 18px;
        font-weight: 800;
        color: #fff;
        line-height: 1.35;
        margin-bottom: 8px;
    }

    .mag-hero-side .mag-card-title { font-size: 14px; }

    .mag-card-meta {
        font-size: 11px;
        color: rgba(255,255,255,0.5);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .mag-section-title {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.12em;
        color: rgba(255,255,255,0.35);
        text-transform: uppercase;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .mag-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 16px;
        margin-bottom: 48px;
    }

    .mag-card {
        background: #0d0d0d;
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 14px;
        overflow: hidden;
        cursor: pointer;
        transition: border-color 0.2s, transform 0.2s;
    }

    .mag-card:hover {
        border-color: rgba(255,255,255,0.18);
        transform: translateY(-3px);
    }

    .mag-card img {
        width: 100%;
        height: 180px;
        object-fit: cover;
        display: block;
    }

    .mag-card-body {
        padding: 16px;
    }

    .mag-card-body .mag-card-tag { margin-bottom: 8px; }

    .mag-card-body .mag-card-title {
        font-size: 14px;
        font-weight: 700;
        color: #fff;
        line-height: 1.4;
        margin-bottom: 8px;
    }

    .mag-card-excerpt {
        font-size: 12px;
        color: rgba(255,255,255,0.4);
        line-height: 1.65;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-bottom: 12px;
    }

    .mag-card-body .mag-card-meta { font-size: 11px; color: rgba(255,255,255,0.3); }

    .mag-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 48px;
    }

    .mag-list-item {
        display: flex;
        gap: 16px;
        background: #0d0d0d;
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 12px;
        overflow: hidden;
        cursor: pointer;
        transition: border-color 0.2s;
    }

    .mag-list-item:hover { border-color: rgba(255,255,255,0.18); }

    .mag-list-item img {
        width: 110px;
        height: 90px;
        object-fit: cover;
        flex-shrink: 0;
    }

    .mag-list-body {
        padding: 14px 16px 14px 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .mag-list-body .mag-card-tag { margin-bottom: 6px; }

    .mag-list-title {
        font-size: 13px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 4px;
        line-height: 1.4;
    }

    .mag-list-meta {
        font-size: 11px;
        color: rgba(255,255,255,0.3);
    }

    @@media (max-width: 800px) {
        .mag-hero { grid-template-columns: 1fr; }
        .mag-hero-main { grid-row: span 1; }
        .mag-hero-main img { height: 260px; }
        .mag-hero-side img { height: 180px; }
    }
    @@media (max-width: 600px) {
        .mag-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="et-section">
    <div class="et-section-header">
        <span class="et-section-title">Magazin</span>
        <span style="font-size:12px;color:rgba(255,255,255,0.3)">Müzik dünyasından haberler</span>
    </div>

    <div class="mag-wrap">

        <!-- HERO BÖLÜMÜ -->
