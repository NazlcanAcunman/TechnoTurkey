            {
                <div style="border-radius:16px;overflow:hidden;aspect-ratio:1;position:relative;cursor:pointer;background:#0d0d0d;">
                    <img src="@photoGrid[i]"
                         alt="Konser Fotoğrafı @(i+1)"
