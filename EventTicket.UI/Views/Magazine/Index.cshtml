                    <div class="mag-card-meta"><i class="bi bi-calendar3"></i> 30 Mart 2026 · <i class="bi bi-clock"></i> 3 dk</div>
                </div>
            </a>
            <a asp-controller="Magazine" asp-action="Details" asp-route-slug="news-4" class="mag-card" style="text-decoration:none">
