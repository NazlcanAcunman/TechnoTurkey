                </div>
            </a>
            <a asp-controller="Magazine" asp-action="Details" asp-route-slug="news-2" class="mag-card" style="text-decoration:none">
                <img src="https://cdn.bugece.co/85df50ee-660e-42a6-a253-9c1cb5406e08" alt="ADRIATIQUE" />
                <div class="mag-card-body">
                    <span class="mag-card-tag">Trend</span>
                    <div class="mag-card-title">Melodic Techno Neden Bu Kadar Popüler? ADRIATIQUE ile Konuştuk</div>
