@model EventTicket.UI.ViewModels.MagazineArticleViewModel
@{
    ViewData["Title"] = Model.Title + " - Magazin";
}

<style>
    .mag-detail-wrap {
        max-width: 820px;
        margin: 0 auto;
        padding: 0 24px 80px;
    }

    .mag-detail-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        font-weight: 600;
        color: rgba(255,255,255,0.4);
        text-decoration: none;
        margin-bottom: 32px;
        transition: color 0.2s;
    }
    .mag-detail-back:hover { color: #fff; }

    .mag-detail-tag {
        display: inline-block;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.12em;
        color: #000;
        background: #fff;
        padding: 3px 10px;
        border-radius: 4px;
        text-transform: uppercase;
        margin-bottom: 16px;
    }

    .mag-detail-title {
        font-size: 28px;
        font-weight: 800;
        color: #fff;
        line-height: 1.3;
        margin-bottom: 20px;
    }

    .mag-detail-meta {
        display: flex;
        align-items: center;
        gap: 16px;
        font-size: 12px;
        color: rgba(255,255,255,0.35);
        margin-bottom: 32px;
        padding-bottom: 24px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .mag-detail-img {
        width: 100%;
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 36px;
        background: #1a1a1a;
    }

    .mag-detail-img img {
        width: 100%;
        height: 420px;
        object-fit: cover;
        display: block;
    }

    .mag-detail-body {
        font-size: 16px;
        color: rgba(255,255,255,0.7);
        line-height: 1.85;
    }

    .mag-detail-body p {
        margin-bottom: 20px;
    }

    .mag-detail-divider {
        border: none;
        border-top: 1px solid rgba(255,255,255,0.06);
        margin: 40px 0;
    }

    .mag-detail-more-title {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.12em;
        color: rgba(255,255,255,0.35);
        text-transform: uppercase;
        margin-bottom: 20px;
    }

    @@media (max-width: 600px) {
        .mag-detail-title { font-size: 20px; }
        .mag-detail-img img { height: 220px; }
    }
</style>

<div class="et-section" style="padding-top:0">
    <div class="mag-detail-wrap">

        <a asp-controller="Magazine" asp-action="Index" class="mag-detail-back">
            <i class="bi bi-arrow-left"></i> Magazin'e Dön
        </a>

        <span class="mag-detail-tag">@Model.Tag</span>

        <h1 class="mag-detail-title">@Model.Title</h1>

        <div class="mag-detail-meta">
            <span><i class="bi bi-person"></i> @Model.Author</span>
            <span><i class="bi bi-calendar3"></i> @Model.Date</span>
            <span><i class="bi bi-clock"></i> @Model.ReadTime okuma</span>
        </div>

        <div class="mag-detail-img">
            <img src="@Model.ImageUrl" alt="@Model.Title" />
        </div>

        <div class="mag-detail-body">
            @foreach (var para in Model.Content.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                <p>@para</p>
            }
        </div>

        <hr class="mag-detail-divider" />

        <div class="mag-detail-more-title">Daha Fazla Oku</div>
        <div style="text-align:center">
            <a asp-controller="Magazine" asp-action="Index" class="et-hero-btn">
                <i class="bi bi-grid"></i> TÜM HABERLER
            </a>
        </div>

    </div>
</div>
