@model List<EventTicket.UI.ViewModels.AcademyContentViewModel>
@{
    ViewData["Title"] = "Akademi";
    var infoItems    = Model.Where(x => x.Type == "info"    && x.IsActive).OrderBy(x => x.DisplayOrder).ToList();
    var photoItems   = Model.Where(x => x.Type == "photo"   && x.IsActive).OrderBy(x => x.DisplayOrder).ToList();
    var studentItems = Model.Where(x => x.Type == "student" && x.IsActive).OrderBy(x => x.DisplayOrder).ToList();
    var videoItems   = Model.Where(x => x.Type == "video"   && x.IsActive).OrderBy(x => x.DisplayOrder).ToList();
    var instructorItems = Model.Where(x => x.Type == "instructor" && x.IsActive).OrderBy(x => x.DisplayOrder).ToList();
    var courseItems     = Model.Where(x => x.Type == "course"     && x.IsActive).OrderBy(x => x.DisplayOrder).ToList();
    var workshopItems   = Model.Where(x => x.Type == "workshop"   && x.IsActive).OrderBy(x => x.DisplayOrder).ToList();
    var bannerItems     = Model.Where(x => x.Type == "banner"     && x.IsActive).OrderBy(x => x.DisplayOrder).ToList();
}

<style>
    .academy-page {
        background: #0a0a0a;
        min-height: 100vh;
        color: #fff;
        font-family: inherit;
    }
    .academy-hero {
        text-align: center;
        padding: 32px 24px 24px;
        border-bottom: 1px solid rgba(255,255,255,0.07);
    }
    .academy-hero h1 {
        font-size: clamp(1.05rem, 1.6vw, 1.35rem);
        font-weight: 900;
        letter-spacing: -0.02em;
        color: #fff;
        margin: 0 0 6px;
    }
    .academy-hero p {
        font-size: 0.85rem;
        color: rgba(255,255,255,0.5);
        margin: 0;
    }
    .academy-section {
        max-width: 1200px;
        margin: 0 auto;
        padding: 60px 24px;
    }
    .academy-section-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: #fff;
        margin: 0 0 32px;
        padding-bottom: 16px;
        border-bottom: 1px solid rgba(255,255,255,0.07);
        letter-spacing: -0.01em;
    }
    /* Glass card */
    .glass-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 14px;
        padding: 24px;
    }
    /* Info items */
    .info-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    .info-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 14px;
        padding: 24px 28px;
    }
    .info-card h3 {
        font-size: 1.05rem;
        font-weight: 700;
        color: #fff;
        margin: 0 0 8px;
    }
    .info-card p {
        font-size: 0.92rem;
        color: rgba(255,255,255,0.5);
        margin: 0;
        line-height: 1.6;
    }
    /* Photo grid */
    .photo-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 18px;
    }
    .photo-item {
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.08);
    }
    .photo-item img {
        width: 100%;
        aspect-ratio: 4/3;
        object-fit: cover;
        display: block;
        transition: transform 0.5s ease;
    }
    .photo-item:hover img { transform: scale(1.08); }
    /* Student cards */
    .student-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 20px;
    }
    .student-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 14px;
        padding: 24px 20px;
        text-align: center;
    }
    .student-card img {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid rgba(255,255,255,0.12);
        margin: 0 auto 14px;
        display: block;
        transition: transform 0.4s ease;
    }
    .student-card:hover img { transform: scale(1.1); }
    .student-card .student-avatar-placeholder {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: rgba(255,255,255,0.08);
        border: 2px solid rgba(255,255,255,0.12);
        margin: 0 auto 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: rgba(255,255,255,0.3);
    }
    .student-card h3 {
        font-size: 0.95rem;
        font-weight: 700;
        color: #fff;
        margin: 0 0 8px;
    }
    .student-card p {
        font-size: 0.82rem;
        color: rgba(255,255,255,0.45);
        margin: 0;
        line-height: 1.5;
    }
    /* Video grid */
    .video-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 20px;
    }
    .video-wrapper {
        position: relative;
        padding-bottom: 56.25%;
        height: 0;
        overflow: hidden;
        border-radius: 14px;
        border: 1px solid rgba(255,255,255,0.08);
        background: rgba(0,0,0,0.4);
    }
    .video-wrapper iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: none;
        border-radius: 14px;
    }
    /* Section divider */
    .section-divider {
        border: none;
        border-top: 1px solid rgba(255,255,255,0.07);
        margin: 0;
    }
    /* Instructor cards */
    .instructor-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
        gap: 14px;
        max-width: 760px;
    }
    .instructor-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 12px;
        overflow: hidden;
        text-align: center;
    }
    .instructor-card img {
        width: 100%;
        aspect-ratio: 3/4;
        object-fit: cover;
        object-position: top center;
        display: block;
        transition: transform 0.5s ease;
    }
    .instructor-card:hover img { transform: scale(1.08); }
    .instructor-avatar-placeholder {
        width: 100%;
        aspect-ratio: 3/4;
        background: rgba(255,255,255,0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        color: rgba(255,255,255,0.3);
    }
    .instructor-card-body {
        padding: 10px 10px 12px;
    }
    .instructor-card h3 {
        font-size: 0.8rem;
        font-weight: 700;
        color: #fff;
        margin: 0 0 6px;
    }
    .instructor-ig-link {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.68rem;
        font-weight: 600;
        color: #fff;
        text-decoration: none;
        background: linear-gradient(135deg,#833ab4,#fd1d1d,#fcb045);
        padding: 5px 10px;
        border-radius: 100px;
        transition: opacity .2s;
    }
    .instructor-ig-link:hover { opacity: 0.85; }
    .content-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.82rem;
        font-weight: 700;
        color: #fff;
        text-decoration: none;
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.18);
        padding: 6px 16px;
        border-radius: 100px;
        margin-top: 6px;
        transition: background .2s;
    }
    .content-link:hover { background: rgba(255,255,255,0.18); }

    /* Course / Workshop carousel (afiş + açıklama) */
    .course-carousel-wrap {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }
    .course-carousel-wrap > .course-card:last-child:nth-child(odd) {
        grid-column: 1 / -1;
        justify-self: center;
        width: 100%;
        max-width: calc(50% - 10px);
    }
    @@media (max-width: 640px) {
        .course-carousel-wrap { grid-template-columns: 1fr; }
        .course-carousel-wrap > .course-card:last-child:nth-child(odd) {
            max-width: 100%;
        }
    }
    .course-card {
        width: 100%;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 14px;
        overflow: hidden;
        display: flex;
        flex-direction: row;
        transition: border-color .25s, box-shadow .25s;
    }
    .course-card:hover {
        border-color: rgba(255,255,255,0.2);
        box-shadow: 0 14px 36px rgba(0,0,0,0.5);
    }
    .course-card-img-wrap {
        flex: 0 0 60%;
        aspect-ratio: 3/4;
        overflow: hidden;
        background: #0d0d0d;
    }
    .course-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
        display: block;
        transition: transform 0.5s ease;
    }
    .course-card:hover img { transform: scale(1.08); }
    .course-card-placeholder {
        flex: 0 0 60%;
        aspect-ratio: 3/4;
        background: rgba(255,255,255,0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        color: rgba(255,255,255,0.3);
    }
    .course-card-body {
        padding: 16px 18px;
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
    }
    .course-card h3 {
        font-size: 1rem;
        font-weight: 700;
        color: #fff;
        margin: 0 0 8px;
    }
    .course-card p {
        font-size: 0.83rem;
        color: rgba(255,255,255,0.55);
        margin: 0 0 10px;
        line-height: 1.6;
    }

    /* Büyük hero banner slayt (anasayfadaki gibi) */
    .academy-banner-hero {
        position: relative;
        width: 100%;
        height: clamp(280px, 40vh, 440px);
        overflow: hidden;
        background: #080808;
    }
    .academy-banner-slide {
        position: absolute;
        inset: 0;
        opacity: 0;
        transition: opacity 0.9s ease;
        pointer-events: none;
        display: block;
        cursor: default;
    }
    .academy-banner-slide.active {
        opacity: 1;
        pointer-events: auto;
    }
    .academy-banner-slide img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.6s ease;
    }
    a.academy-banner-slide { cursor: pointer; }
    a.academy-banner-slide:hover img { transform: scale(1.04); }
    .academy-banner-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 4;
        width: 38px; height: 38px;
        border-radius: 50%;
        background: rgba(0,0,0,0.6);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,0.15);
        color: #fff;
        font-size: 15px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .academy-banner-arrow:hover { background: rgba(0,0,0,0.8); }
    .academy-banner-l { left: 16px; }
    .academy-banner-r { right: 16px; }
    @@media (max-width: 768px) {
        .academy-banner-arrow { width: 32px; height: 32px; font-size: 13px; }
        .course-card h3 { font-size: 0.9rem; }
        .course-card p { font-size: 0.78rem; }
        .course-card-body { padding: 12px 14px; }
    }
</style>

<div class="academy-page">

    <!-- HERO -->
    <div class="academy-hero">
        <h1>TechnoTurkey Akademi</h1>
        <p>Müzik dünyasına adım atmak isteyenler için.</p>
    </div>

    @if (bannerItems.Any())
    {
        <div class="academy-banner-hero" id="academyBannerHero">
            @for (int i = 0; i < bannerItems.Count; i++)
            {
                var item = bannerItems[i];
                var slideClass = "academy-banner-slide" + (i == 0 ? " active" : "");
                @if (!string.IsNullOrEmpty(item.LinkUrl))
                {
                    <a href="@item.LinkUrl" target="_blank" rel="noopener" class="@slideClass">
                        <img src="@item.MediaUrl" alt="@item.Title" />
                    </a>
                }
                else
                {
                    <div class="@slideClass">
                        <img src="@item.MediaUrl" alt="@item.Title" />
                    </div>
                }
            }
            @if (bannerItems.Count > 1)
            {
                <button class="academy-banner-arrow academy-banner-l" onclick="academyBannerNav(-1)"><i class="bi bi-chevron-left"></i></button>
                <button class="academy-banner-arrow academy-banner-r" onclick="academyBannerNav(1)"><i class="bi bi-chevron-right"></i></button>
            }
        </div>
    }

    @if (instructorItems.Any())
    {
        <div class="academy-section">
            <div class="academy-section-title">Eğitmenlerimiz</div>
            <div class="instructor-grid">
                @foreach (var item in instructorItems)
                {
                    <div class="instructor-card">
                        @if (!string.IsNullOrEmpty(item.MediaUrl))
                        {
                            <img src="@item.MediaUrl" alt="@item.Title" />
                        }
                        else
                        {
                            <div class="instructor-avatar-placeholder">&#128100;</div>
                        }
                        <div class="instructor-card-body">
                            <h3>@item.Title</h3>
                            @if (!string.IsNullOrEmpty(item.LinkUrl))
                            {
                                <a href="@item.LinkUrl" target="_blank" rel="noopener" class="instructor-ig-link">
                                    <i class="bi bi-instagram"></i> Profili Gör
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
        <hr class="section-divider" />
    }

    @if (infoItems.Any())
    {
        <div class="academy-section">
            <div class="academy-section-title">Hakkımızda</div>
            <div class="info-list">
                @foreach (var item in infoItems)
                {
                    <div class="info-card">
                        <h3>@item.Title</h3>
                        @if (!string.IsNullOrEmpty(item.Description))
                        {
                            <p>@item.Description</p>
                        }
                    </div>
                }
            </div>
        </div>
        <hr class="section-divider" />
    }

    @if (courseItems.Any())
    {
        <div class="academy-section">
            <div class="academy-section-title">Eğitimlerimiz</div>
            <div class="course-carousel-wrap">
                @foreach (var item in courseItems)
                {
                    <div class="course-card">
                        @if (!string.IsNullOrEmpty(item.MediaUrl))
                        {
                            <div class="course-card-img-wrap">
                                <img src="@item.MediaUrl" alt="@item.Title" />
                            </div>
                        }
                        else
                        {
                            <div class="course-card-placeholder">&#127891;</div>
                        }
                        <div class="course-card-body">
                            <h3>@item.Title</h3>
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <p>@item.Description</p>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
        <hr class="section-divider" />
    }

    @if (workshopItems.Any())
    {
        <div class="academy-section">
            <div class="academy-section-title">Workshoplarımız</div>
            <div class="course-carousel-wrap">
                @foreach (var item in workshopItems)
                {
                    <div class="course-card">
                        @if (!string.IsNullOrEmpty(item.MediaUrl))
                        {
                            <div class="course-card-img-wrap">
                                <img src="@item.MediaUrl" alt="@item.Title" />
                            </div>
                        }
                        else
                        {
                            <div class="course-card-placeholder">&#127891;</div>
                        }
                        <div class="course-card-body">
                            <h3>@item.Title</h3>
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <p>@item.Description</p>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
        <hr class="section-divider" />
    }

    @if (photoItems.Any())
    {
        <div class="academy-section">
            <div class="academy-section-title">Fotoğraflar</div>
            <div class="photo-grid">
                @foreach (var item in photoItems)
                {
                    @if (!string.IsNullOrEmpty(item.MediaUrl))
                    {
                        <div class="photo-item">
                            <img src="@item.MediaUrl" alt="@item.Title" title="@item.Title" loading="lazy" />
                        </div>
                    }
                }
            </div>
        </div>
        <hr class="section-divider" />
    }

    @if (studentItems.Any())
    {
        <div class="academy-section">
            <div class="academy-section-title">Öğrencilerimiz</div>
            <div class="student-grid">
                @foreach (var item in studentItems)
                {
                    <div class="student-card">
                        @if (!string.IsNullOrEmpty(item.MediaUrl))
                        {
                            <img src="@item.MediaUrl" alt="@item.Title" />
                        }
                        else
                        {
                            <div class="student-avatar-placeholder">&#128100;</div>
                        }
                        <h3>@item.Title</h3>
                        @if (!string.IsNullOrEmpty(item.Description))
                        {
                            <p>@item.Description</p>
                        }
                    </div>
                }
            </div>
        </div>
        <hr class="section-divider" />
    }

    @if (videoItems.Any())
    {
        <div class="academy-section">
            <div class="academy-section-title">Videolar</div>
            <div class="video-grid">
                @foreach (var item in videoItems)
                {
                    @if (!string.IsNullOrEmpty(item.MediaUrl))
                    {
                        <div>
                            @if (!string.IsNullOrEmpty(item.Title))
                            {
                                <div style="font-size:0.9rem;font-weight:600;color:rgba(255,255,255,0.7);margin-bottom:10px">@item.Title</div>
                            }
                            <div class="video-wrapper">
                                <iframe src="@item.MediaUrl" allowfullscreen loading="lazy"></iframe>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
        <hr class="section-divider" />
    }

    <!-- CTA -->
    <div style="text-align:center;padding:60px 24px;border-top:1px solid rgba(255,255,255,0.07)">
        <p style="font-size:0.95rem;color:rgba(255,255,255,0.4);margin:0 0 20px">Akademi hakkında daha fazla bilgi almak ister misiniz?</p>
        <button onclick="document.getElementById('contactModal').style.display='flex'"
                style="display:inline-flex;align-items:center;gap:8px;background:#fff;color:#000;
                       font-weight:700;font-size:14px;padding:14px 28px;border-radius:100px;
                       border:none;cursor:pointer;font-family:inherit;transition:opacity .2s"
                onmouseover="this.style.opacity='.85'" onmouseout="this.style.opacity='1'">
            <i class="bi bi-chat-dots-fill"></i> Detaylı Bilgi Al
        </button>
    </div>

</div>

<!-- Contact Modal -->
<div id="contactModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:9999;align-items:center;justify-content:center"
     onclick="if(event.target===this)this.style.display='none'">
    <div style="background:#111;border:1px solid rgba(255,255,255,0.12);border-radius:20px;padding:36px;width:min(360px,92vw);text-align:center">
        <div style="font-size:18px;font-weight:800;color:#fff;margin-bottom:8px">Bize Ulaşın</div>
        <div style="font-size:13px;color:rgba(255,255,255,0.4);margin-bottom:28px">Akademi hakkında bilgi almak için tercih ettiğiniz platformu seçin.</div>
        <div style="display:flex;flex-direction:column;gap:12px">
            <a href="https://wa.me/905000000000" target="_blank"
               style="display:flex;align-items:center;justify-content:center;gap:10px;background:#25D366;color:#fff;font-weight:700;font-size:14px;padding:14px;border-radius:12px;text-decoration:none">
                <i class="bi bi-whatsapp" style="font-size:18px"></i> WhatsApp ile Yaz
            </a>
            <a href="https://instagram.com/technoturkey" target="_blank"
               style="display:flex;align-items:center;justify-content:center;gap:10px;background:linear-gradient(135deg,#833ab4,#fd1d1d,#fcb045);color:#fff;font-weight:700;font-size:14px;padding:14px;border-radius:12px;text-decoration:none">
                <i class="bi bi-instagram" style="font-size:18px"></i> Instagram'dan Yaz
            </a>
        </div>
        <button onclick="document.getElementById('contactModal').style.display='none'"
                style="margin-top:20px;background:none;border:none;color:rgba(255,255,255,0.3);cursor:pointer;font-size:13px;font-family:inherit">
            Kapat
        </button>
    </div>
</div>

<script>
    function sc(id, dir) {
        var el = document.getElementById(id);
        if (el) el.scrollBy({ left: dir * 340, behavior: 'smooth' });
    }

    var academyBannerIndex = 0;
    function academyBannerNav(dir) {
        var wrap = document.getElementById("academyBannerHero");
        if (!wrap) return;
        var slides = wrap.querySelectorAll(".academy-banner-slide");
        if (slides.length === 0) return;

        slides[academyBannerIndex].classList.remove("active");
        academyBannerIndex = (academyBannerIndex + dir + slides.length) % slides.length;
        slides[academyBannerIndex].classList.add("active");
    }

    (function () {
        var wrap = document.getElementById("academyBannerHero");
        if (wrap && wrap.querySelectorAll(".academy-banner-slide").length > 1) {
            setInterval(function () { academyBannerNav(1); }, 6000);
        }
    })();
</script>
