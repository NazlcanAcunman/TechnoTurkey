@model EventTicket.UI.ViewModels.VenueDetailViewModel
@{
    ViewData["Title"] = Model.Venue.Name;
}

<div class="event-detail">
    <div class="event-detail-body">
        <div class="event-detail-info">
            <h1 class="event-detail-title">@Model.Venue.Name</h1>
            <div class="event-detail-meta">
                <div class="event-detail-meta-item">
                    <span>Şehir</span>@Model.Venue.City
                </div>
                <div class="event-detail-meta-item">
                    <span>Adres</span>@Model.Venue.Address
                </div>
                @if (!string.IsNullOrEmpty(Model.Venue.Description))
                {
                    <div class="event-detail-meta-item">
                        <span>Hakkında</span>@Model.Venue.Description
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- YORUM BÖLÜMÜ -->
<div class="ev-comments">
    <div class="ev-comments-inner">
        <div class="ev-comments-title">Yorumlar <span>(@Model.Comments.Count)</span></div>

        @if (Model.Comments.Any())
        {
            <div class="ev-comment-list">
                @foreach (var comment in Model.Comments)
                {
                    <div class="ev-comment-card">
                        <div class="ev-comment-header">
                            <div>
                                <div class="ev-comment-author">@comment.UserFullName</div>
                                <div class="ev-comment-stars">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="@(i <= comment.Rating ? "star-on" : "star-off")">★</span>
                                    }
                                </div>
                            </div>
                            <div style="display:flex;align-items:center;gap:12px">
                                <span class="ev-comment-date">@comment.CreatedAt.ToString("dd MMM yyyy")</span>
                                @if (User.IsInRole("SuperAdmin"))
                                {
                                    <form asp-controller="Comments" asp-action="Delete" method="post">
                                        <input type="hidden" name="id" value="@comment.Id" />
                                        <input type="hidden" name="returnVenueId" value="@Model.Venue.Id" />
                                        <button type="submit" class="ev-delete-btn"
                                                onclick="return confirm('Yorumu silmek istediğinize emin misiniz?')">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                        <div class="ev-comment-text">@comment.Content</div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="ev-comment-empty">Henüz yorum yapılmamış. İlk yorumu sen yap!</div>
        }

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="ev-comment-form">
                <div class="ev-comment-form-title">Yorum Yap</div>
                <form asp-action="AddComment" asp-controller="Venues" method="post">
                    <input type="hidden" asp-for="NewComment.VenueId" />
                    <div class="ev-form-row">
                        <div class="ev-form-field" style="width:160px">
                            <label class="et-label">Puanınız</label>
                            <select asp-for="NewComment.Rating" class="ev-select">
                                <option value="5">★★★★★ (5)</option>
                                <option value="4">★★★★☆ (4)</option>
                                <option value="3">★★★☆☆ (3)</option>
                                <option value="2">★★☆☆☆ (2)</option>
                                <option value="1">★☆☆☆☆ (1)</option>
                            </select>
                        </div>
                        <div class="ev-form-field" style="flex:1">
                            <label class="et-label">Yorumunuz</label>
                            <textarea asp-for="NewComment.Content" class="et-input" rows="3"
                                      placeholder="Bu mekan hakkında ne düşünüyorsunuz?"></textarea>
                        </div>
                    </div>
                    <button type="submit" class="et-btn-primary" style="margin-top:12px">
                        Yorum Gönder
                    </button>
                </form>
            </div>
        }
        else
        {
            <div class="ev-login-prompt">
                Yorum yapmak için <a asp-controller="Auth" asp-action="Login">giriş yapın</a>.
            </div>
        }
    </div>
</div>

<style>
    .ev-comments {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 24px 60px;
        border-top: 1px solid rgba(255,255,255,0.06);
        margin-top: 40px;
    }
    .ev-comments-inner { padding-top: 32px; }
    .ev-comments-title { font-size: 18px; font-weight: 700; color: #fff; margin-bottom: 24px; }
    .ev-comments-title span { color: rgba(255,255,255,0.3); font-weight: 400; font-size: 15px; }
    .ev-comment-list { display: flex; flex-direction: column; gap: 12px; margin-bottom: 32px; }
    .ev-comment-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.07); border-radius: 14px; padding: 16px; }
    .ev-comment-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px; }
    .ev-comment-author { font-size: 13px; font-weight: 700; color: #fff; margin-bottom: 4px; }
    .ev-comment-stars { font-size: 14px; }
    .star-on { color: #f5a623; }
    .star-off { color: rgba(255,255,255,0.15); }
    .ev-comment-date { font-size: 11px; color: rgba(255,255,255,0.25); }
    .ev-comment-text { font-size: 14px; color: rgba(255,255,255,0.6); line-height: 1.7; }
    .ev-delete-btn { width: 28px; height: 28px; border-radius: 6px; border: 1px solid rgba(248,113,113,0.2); background: rgba(248,113,113,0.05); color: #f87171; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 12px; transition: all 0.2s; }
    .ev-delete-btn:hover { background: rgba(248,113,113,0.15); }
    .ev-comment-empty { font-size: 13px; color: rgba(255,255,255,0.25); padding: 24px 0; }
    .ev-comment-form { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.07); border-radius: 16px; padding: 24px; margin-top: 24px; }
    .ev-comment-form-title { font-size: 14px; font-weight: 700; color: #fff; margin-bottom: 16px; }
    .ev-form-row { display: flex; gap: 16px; flex-wrap: wrap; }
    .ev-form-field { display: flex; flex-direction: column; gap: 6px; }
    .ev-select { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 11px 14px; color: #fff; font-size: 13px; font-family: inherit; outline: none; }
    .ev-login-prompt { font-size: 13px; color: rgba(255,255,255,0.3); padding: 20px; background: rgba(255,255,255,0.03); border-radius: 10px; margin-top: 20px; }
    .ev-login-prompt a { color: #fff; font-weight: 600; }
</style>
