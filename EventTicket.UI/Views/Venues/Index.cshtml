@model List<EventTicket.UI.ViewModels.VenueCardViewModel>
@{
    ViewData["Title"] = "Mekanlar";
}

<style>
    .venues-grid {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 20px;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 14px;
    }

    .venue-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 18px;
        overflow: hidden;
        transition: border-color 0.22s, transform 0.22s, box-shadow 0.22s;
        display: flex;
        flex-direction: column;
    }

    .venue-card:hover {
        border-color: rgba(255,255,255,0.16);
        transform: translateY(-5px);
        box-shadow: 0 20px 56px rgba(0,0,0,0.8);
    }

    .venue-card-img {
        width: 100%;
        height: 140px;
        background: #0d0d0d;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

    .venue-card-city-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: rgba(255,255,255,0.8);
        background: rgba(0,0,0,0.5);
        border: 1px solid rgba(255,255,255,0.15);
        padding: 4px 10px;
        border-radius: 100px;
        display: flex;
        align-items: center;
        gap: 4px;
        backdrop-filter: blur(4px);
    }

    .venue-card-body {
        padding: 16px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .venue-card-name {
        font-size: 15px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 6px;
    }

    .venue-card-address {
        font-size: 11px;
        color: rgba(255,255,255,0.35);
        margin-bottom: 10px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .venue-card-desc {
        font-size: 12px;
        color: rgba(255,255,255,0.4);
        line-height: 1.65;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-bottom: 14px;
        flex: 1;
    }

    .venue-card-stats {
        display: flex;
        gap: 20px;
        margin-bottom: 14px;
        padding-top: 12px;
        border-top: 1px solid rgba(255,255,255,0.05);
    }

    .venue-stat {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .venue-stat-num {
        font-size: 13px;
        font-weight: 700;
        color: #fff;
    }

    .venue-stat-label {
        font-size: 10px;
        color: rgba(255,255,255,0.3);
        letter-spacing: 0.04em;
    }

    .venue-card-actions {
        display: flex;
        gap: 8px;
    }

    .venue-follow-btn {
        flex: 1;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.09);
        border-radius: 100px;
        padding: 8px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.05em;
        color: rgba(255,255,255,0.6);
        cursor: pointer;
        font-family: inherit;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .venue-follow-btn:hover,
    .venue-follow-btn.active {
        background: rgba(255,255,255,0.1);
        border-color: rgba(255,255,255,0.25);
        color: #fff;
    }

    .venue-detail-btn {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.09);
        border-radius: 100px;
        padding: 8px 14px;
        font-size: 11px;
        font-weight: 700;
        color: rgba(255,255,255,0.5);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 5px;
        transition: all 0.2s;
        white-space: nowrap;
    }

    .venue-detail-btn:hover {
        color: #fff;
        border-color: rgba(255,255,255,0.25);
    }

    @@media (max-width: 600px) {
        .venues-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="et-section">
    <div class="et-section-header">
        <span class="et-section-title">Mekanlar</span>
        <span style="font-size:12px;color:rgba(255,255,255,0.3)">@Model.Count mekan</span>
    </div>

    @if (!Model.Any())
    {
        <div class="et-empty-state">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                 style="color:rgba(255,255,255,0.15);margin:0 auto 16px;display:block">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" />
            </svg>
            <p>Henüz mekan bulunmuyor.</p>
        </div>
    }
    else
    {
        <div class="venues-grid">
            @foreach (var venue in Model)
            {
                var followers = ((venue.Id * 213 + 77) % 500 + 50) * 1000;
                var followerStr = followers >= 1000000
                    ? $"{followers / 1000000.0:F1}M"
                    : $"{followers / 1000}K";
                var eventCount = (venue.Id % 12) + 5;
                var rating = 4.0 + (venue.Id % 10) * 0.1;
                <div class="venue-card">
                    <div class="venue-card-img" style="padding:0;background:none;">
                        <img src="https://picsum.photos/seed/venue-@venue.Id/400/180"
                             alt="@venue.Name"
                             style="width:100%;height:100%;object-fit:cover;display:block;" />
                        <div class="venue-card-city-badge">
                            <i class="bi bi-geo-alt-fill"></i> @venue.City
                        </div>
                    </div>
                    <div class="venue-card-body">
                        <div class="venue-card-name">@venue.Name</div>
                        @if (!string.IsNullOrEmpty(venue.Address))
                        {
                            <div class="venue-card-address">
                                <i class="bi bi-signpost"></i> @venue.Address
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(venue.Description))
                        {
                            <div class="venue-card-desc">@venue.Description</div>
                        }
                        <div class="venue-card-stats">
                            <div class="venue-stat">
                                <span class="venue-stat-num">@followerStr</span>
                                <span class="venue-stat-label">Takipçi</span>
                            </div>
                            <div class="venue-stat">
                                <span class="venue-stat-num">@eventCount</span>
                                <span class="venue-stat-label">Etkinlik</span>
                            </div>
                            <div class="venue-stat">
                                <span class="venue-stat-num">@rating.ToString("F1") <i class="bi bi-star-fill" style="font-size:10px;color:rgba(255,255,255,0.6)"></i></span>
                                <span class="venue-stat-label">Puan</span>
                            </div>
                        </div>
                        <div class="venue-card-actions">
                            <button class="venue-follow-btn"
                                    data-venue-id="@venue.Id"
                                    data-following="false"
                                    onclick="toggleFollow(this)">
                                <i class="bi bi-heart"></i> Takip Et
                            </button>
                            <a asp-controller="Venues" asp-action="Details"
                               asp-route-id="@venue.Id" class="venue-detail-btn">
                                Detay <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        async function toggleFollow(btn) {
            if (btn._loading) return;
            const isFollowing = btn.dataset.following === 'true';
            if (isFollowing) {
                btn.innerHTML = '<i class="bi bi-heart"></i> Takip Et';
                btn.classList.remove('active');
                btn.dataset.following = 'false';
                return;
            }
            const venueId = btn.dataset.venueId;
            if (!venueId || venueId === '0') return;
            btn._loading = true;
            const fd = new FormData();
            fd.append('venueId', venueId);
            try {
                const resp = await fetch('/Profile/AddFavorite', { method: 'POST', body: fd });
                if (resp.redirected && resp.url.includes('/Auth/Login')) {
                    window.location.href = '/Auth/Login';
                } else if (resp.ok || resp.redirected) {
                    btn.innerHTML = '<i class="bi bi-heart-fill"></i> Takip Ediliyor';
                    btn.classList.add('active');
                    btn.dataset.following = 'true';
                } else if (resp.status === 401) {
                    window.location.href = '/Auth/Login';
                }
            } catch (e) { }
            btn._loading = false;
        }
    </script>
}
