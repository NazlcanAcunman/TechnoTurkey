@model EventTicket.UI.ViewModels.CartCheckoutViewModel
@{
    ViewData["Title"] = "Ödeme";
}

<style>
    .checkout-page {
        max-width: 1000px;
        margin: 0 auto;
        padding: 0 24px 80px;
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 28px;
        align-items: start;
    }

    .checkout-section-title {
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.12em;
        color: rgba(255,255,255,0.25);
        text-transform: uppercase;
        margin-bottom: 16px;
        margin-top: 28px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .checkout-section-title::after {
        content: '';
        flex: 1;
        height: 1px;
        background: rgba(255,255,255,0.06);
    }

    .checkout-section-title:first-child { margin-top: 0; }

    .checkout-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 18px;
        overflow: hidden;
    }

    .checkout-card-header {
        padding: 16px 20px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        font-size: 13px;
        font-weight: 700;
        color: rgba(255,255,255,0.5);
        letter-spacing: 0.04em;
        text-transform: uppercase;
        font-size: 10px;
    }

    /* Sipariş listesi */
    .order-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 20px;
        border-bottom: 1px solid rgba(255,255,255,0.04);
    }

    .order-item:last-child { border-bottom: none; }

    .order-item-img {
        width: 48px;
        height: 48px;
        border-radius: 8px;
        background: #0d0d0d;
        flex-shrink: 0;
        overflow: hidden;
    }

    .order-item-img img {
        width: 100%; height: 100%;
        object-fit: cover;
    }

    .order-item-info { flex: 1; min-width: 0; }

    .order-item-title {
        font-size: 13px;
        font-weight: 600;
        color: #fff;
        margin-bottom: 3px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .order-item-meta {
        font-size: 11px;
        color: rgba(255,255,255,0.35);
    }

    .order-item-qty {
        font-size: 11px;
        color: rgba(255,255,255,0.3);
        white-space: nowrap;
    }

    .order-item-price {
        font-size: 13px;
        font-weight: 700;
        color: #fff;
        white-space: nowrap;
    }

    /* Ödeme formu */
    .pay-form {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .pay-field { display: flex; flex-direction: column; gap: 7px; }

    .pay-label {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: rgba(255,255,255,0.35);
        text-transform: uppercase;
    }

    .pay-input {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 10px;
        padding: 12px 16px;
        color: #fff;
        font-size: 14px;
        font-family: inherit;
        outline: none;
        transition: border-color 0.2s, background 0.2s;
        width: 100%;
    }

    .pay-input:focus {
        border-color: rgba(255,255,255,0.3);
        background: rgba(255,255,255,0.04);
    }

    .pay-input::placeholder { color: rgba(255,255,255,0.15); }

    .pay-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

    .pay-card-icon {
        display: flex;
        gap: 8px;
        align-items: center;
        margin-bottom: 4px;
    }

    .pay-card-icon span {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: rgba(255,255,255,0.2);
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.08);
        padding: 3px 8px;
        border-radius: 5px;
    }

    /* Sağ özet kutusu */
    .order-summary {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 18px;
        padding: 20px;
        position: sticky;
        top: 180px;
    }

    .summary-title {
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.1em;
        color: rgba(255,255,255,0.3);
        text-transform: uppercase;
        margin-bottom: 18px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        color: rgba(255,255,255,0.45);
        margin-bottom: 10px;
    }

    .summary-divider {
        height: 1px;
        background: rgba(255,255,255,0.06);
        margin: 16px 0;
    }

    .summary-total {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 20px;
    }

    .summary-total-label {
        font-size: 13px;
        font-weight: 700;
        color: #fff;
    }

    .summary-total-amount {
        font-size: 32px;
        font-weight: 800;
        color: #fff;
    }

    .pay-submit {
        width: 100%;
        background: #fff;
        color: #000;
        border: none;
        border-radius: 10px;
        padding: 15px;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        cursor: pointer;
        font-family: inherit;
        transition: background 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .pay-submit:hover { background: #d4a800; }

    .pay-secure-note {
        text-align: center;
        font-size: 11px;
        color: rgba(255,255,255,0.2);
        margin-top: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .pay-error {
        background: rgba(248,113,113,0.08);
        border: 1px solid rgba(248,113,113,0.2);
        color: #f87171;
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 13px;
        margin-bottom: 16px;
        grid-column: 1 / -1;
    }

    @@media (max-width: 800px) {
        .checkout-page {
            grid-template-columns: 1fr;
        }
        .order-summary { position: static; }
    }
</style>

<div class="et-section" style="padding-top:0">
    <div style="max-width:1000px;margin:0 auto;padding:0 24px 12px">
        <h1 style="font-size:22px;font-weight:800;color:#fff">Ödeme</h1>
    </div>

    <div class="checkout-page">

        @if (TempData["CartError"] != null)
        {
            <div class="pay-error">@TempData["CartError"]</div>
        }

        <!-- SOL: FORM -->
        <div>
            <!-- Sipariş özeti (liste) -->
            <div class="checkout-section-title">Siparişin</div>
            <div class="checkout-card">
                <div class="checkout-card-header">@Model.Cart.TotalItems Bilet</div>
                @foreach (var item in Model.Cart.Items)
                {
                    <div class="order-item">
                        <div class="order-item-img">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.EventTitle" />
                            }
                        </div>
                        <div class="order-item-info">
                            <div class="order-item-title">@item.EventTitle</div>
                            <div class="order-item-meta">
                                <i class="bi bi-geo-alt"></i> @item.VenueName &nbsp;·&nbsp;
                                <i class="bi bi-calendar3"></i> @item.EventDate.ToString("dd MMM yyyy")
                            </div>
                        </div>
                        <div class="order-item-qty">x@item.Quantity</div>
                        <div class="order-item-price">₺@item.SubTotal.ToString("N0")</div>
                    </div>
                }
            </div>

            <!-- Ödeme formu -->
            <div class="checkout-section-title">Ödeme Bilgileri</div>

            <form asp-action="Checkout" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Cart.TotalAmount" />

                <div class="pay-card-icon">
                    <span>VISA</span>
                    <span>MASTERCARD</span>
                    <span>TROY</span>
                </div>

                <div class="pay-form">
                    <div class="pay-field">
                        <label class="pay-label">Kart Üzerindeki İsim</label>
                        <input asp-for="CardHolderName" class="pay-input"
                               placeholder="Ad Soyad" autocomplete="cc-name" required />
                    </div>

                    <div class="pay-field">
                        <label class="pay-label">Kart Numarası</label>
                        <input asp-for="CardNumber" class="pay-input"
                               placeholder="0000  0000  0000  0000"
                               maxlength="19" autocomplete="cc-number"
                               oninput="formatCard(this)" required />
                    </div>

                    <div class="pay-row">
                        <div class="pay-field">
                            <label class="pay-label">Son Kullanma Tarihi</label>
                            <input asp-for="ExpiryDate" class="pay-input"
                                   placeholder="AA / YY" maxlength="7"
                                   autocomplete="cc-exp"
                                   oninput="formatExpiry(this)" required />
                        </div>
                        <div class="pay-field">
                            <label class="pay-label">CVV</label>
                            <input asp-for="CVV" class="pay-input"
                                   placeholder="•••" maxlength="4"
                                   autocomplete="cc-csc"
                                   type="password" required />
                        </div>
                    </div>

                    <button type="submit" class="pay-submit" style="margin-top:8px">
                        <i class="bi bi-lock-fill"></i>
                        ₺@Model.Cart.TotalAmount.ToString("N0") Öde
                    </button>

                    <div class="pay-secure-note">
                        <i class="bi bi-shield-check"></i>
                        256-bit SSL ile korunan güvenli ödeme
                    </div>
                </div>
            </form>
        </div>

        <!-- SAĞ: ÖZET -->
        <div class="order-summary">
            <div class="summary-title">Sipariş Özeti</div>

            @foreach (var item in Model.Cart.Items)
            {
                <div class="summary-row">
                    <span style="color:rgba(255,255,255,0.6)">@item.EventTitle <span style="color:rgba(255,255,255,0.25)">x@item.Quantity</span></span>
                    <span>₺@item.SubTotal.ToString("N0")</span>
                </div>
            }

            <div class="summary-divider"></div>

            <div class="summary-row">
                <span>Hizmet Bedeli</span>
                <span style="color:#4ade80">Ücretsiz</span>
            </div>

            <div class="summary-total">
                <span class="summary-total-label">Toplam</span>
                <span class="summary-total-amount">₺@Model.Cart.TotalAmount.ToString("N0")</span>
            </div>

            <div style="font-size:11px;color:rgba(255,255,255,0.2);line-height:1.7;border-top:1px solid rgba(255,255,255,0.05);padding-top:14px">
                Ödeme tamamlandıktan sonra biletleriniz profilinize eklenecektir.
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function formatCard(input) {
            let v = input.value.replace(/\D/g, '').substring(0, 16);
            input.value = v.replace(/(.{4})/g, '$1  ').trim();
        }

        function formatExpiry(input) {
            let v = input.value.replace(/\D/g, '').substring(0, 4);
            if (v.length >= 2) v = v.substring(0, 2) + ' / ' + v.substring(2);
            input.value = v;
        }
    </script>
}
