@model EventTicket.UI.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Sepetim";
}

<style>
    .cart-wrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 24px 80px;
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 24px;
        align-items: start;
    }

    .cart-title {
        font-size: 24px;
        font-weight: 800;
        color: #fff;
        margin-bottom: 24px;
        grid-column: 1 / -1;
    }

    .cart-table {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 18px;
        overflow: hidden;
    }

    .cart-table-head {
        display: grid;
        grid-template-columns: 1fr 100px 110px 110px 48px;
        gap: 12px;
        padding: 14px 20px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.1em;
        color: rgba(255,255,255,0.3);
        text-transform: uppercase;
    }

    .cart-row {
        display: grid;
        grid-template-columns: 1fr 100px 110px 110px 48px;
        gap: 12px;
        padding: 16px 20px;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        align-items: center;
    }

    .cart-row:last-child { border-bottom: none; }

    .cart-event-title {
        font-size: 14px;
        font-weight: 600;
        color: #fff;
        margin-bottom: 4px;
    }

    .cart-event-meta {
        font-size: 11px;
        color: rgba(255,255,255,0.35);
    }

    .cart-qty-form {
        display: flex;
    }

    .cart-qty-input {
        width: 64px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 8px;
        padding: 6px 10px;
        color: #fff;
        font-size: 13px;
        font-family: inherit;
        outline: none;
        text-align: center;
    }

    .cart-price {
        font-size: 13px;
        color: rgba(255,255,255,0.5);
    }

    .cart-subtotal {
        font-size: 14px;
        font-weight: 700;
        color: #fff;
    }

    .cart-remove-btn {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        border: 1px solid rgba(255,255,255,0.08);
        background: none;
        color: rgba(255,255,255,0.3);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        font-size: 14px;
    }

    .cart-remove-btn:hover {
        border-color: rgba(248,113,113,0.4);
        color: #f87171;
        background: rgba(248,113,113,0.05);
    }

    .cart-clear-btn {
        margin-top: 12px;
        font-size: 11px;
        font-weight: 600;
        color: rgba(255,255,255,0.3);
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: color 0.2s;
    }

    .cart-clear-btn:hover { color: #f87171; }

    .cart-summary {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 18px;
        padding: 24px;
        position: sticky;
        top: 180px;
    }

    .cart-summary-title {
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: rgba(255,255,255,0.4);
        text-transform: uppercase;
        margin-bottom: 20px;
    }

    .cart-summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 13px;
        color: rgba(255,255,255,0.5);
        margin-bottom: 12px;
    }

    .cart-summary-divider {
        height: 1px;
        background: rgba(255,255,255,0.06);
        margin: 16px 0;
    }

    .cart-summary-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .cart-summary-total-label {
        font-size: 14px;
        font-weight: 700;
        color: #fff;
    }

    .cart-summary-total-amount {
        font-size: 28px;
        font-weight: 800;
        color: #fff;
    }

    .cart-checkout-btn {
        display: block;
        width: 100%;
        background: #fff;
        color: #000;
        border: none;
        border-radius: 100px;
        padding: 14px;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-align: center;
        cursor: pointer;
        font-family: inherit;
        transition: background 0.2s;
        margin-bottom: 10px;
    }

    .cart-checkout-btn:hover {
        background: #d4a800;
        color: #111;
    }

    .cart-continue-btn {
        display: block;
        width: 100%;
        text-align: center;
        font-size: 12px;
        font-weight: 600;
        color: rgba(255,255,255,0.4);
        padding: 10px;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 10px;
        transition: all 0.2s;
    }

    .cart-continue-btn:hover {
        color: #fff;
        border-color: rgba(255,255,255,0.25);
    }

    .cart-empty {
        grid-column: 1 / -1;
        text-align: center;
        padding: 100px 24px;
    }

    .cart-empty-icon {
        font-size: 56px;
        color: rgba(255,255,255,0.1);
        margin-bottom: 20px;
    }

    .cart-empty-text {
        font-size: 18px;
        font-weight: 700;
        color: rgba(255,255,255,0.3);
        margin-bottom: 8px;
    }

    .cart-empty-sub {
        font-size: 13px;
        color: rgba(255,255,255,0.2);
        margin-bottom: 28px;
    }

    .cart-alert {
        grid-column: 1 / -1;
        padding: 12px 16px;
        border-radius: 10px;
        font-size: 13px;
        margin-bottom: 4px;
    }

    .cart-alert-success {
        background: rgba(34,197,94,0.1);
        border: 1px solid rgba(34,197,94,0.2);
        color: #4ade80;
    }

    .cart-alert-error {
        background: rgba(248,113,113,0.1);
        border: 1px solid rgba(248,113,113,0.2);
        color: #f87171;
    }

    @@media (max-width: 900px) {
        .cart-wrap {
            grid-template-columns: 1fr;
        }

        .cart-table-head { display: none; }

        .cart-row {
            grid-template-columns: 1fr auto;
            grid-template-rows: auto auto;
        }

        .cart-row > :nth-child(3),
        .cart-row > :nth-child(4) {
            display: none;
        }
    }
</style>

<div class="et-section" style="padding-top:0">
    <div class="cart-wrap">

        <h1 class="cart-title">
            <i class="bi bi-cart3" style="margin-right:10px"></i>Sepetim
        </h1>

        @if (TempData["CartSuccess"] != null)
        {
            <div class="cart-alert cart-alert-success">@TempData["CartSuccess"]</div>
        }
        @if (TempData["CartError"] != null)
        {
            <div class="cart-alert cart-alert-error">@TempData["CartError"]</div>
        }

        @if (!Model.Items.Any())
        {
            <div class="cart-empty">
                <div class="cart-empty-icon"><i class="bi bi-cart-x"></i></div>
                <div class="cart-empty-text">Sepetiniz boş</div>
                <div class="cart-empty-sub">Etkinliklere göz atıp bilet ekleyebilirsiniz.</div>
                <a asp-controller="Events" asp-action="Index" class="et-hero-btn">
                    ETKİNLİKLERE BAK
                </a>
            </div>
        }
        else
        {
            <div>
                <div class="cart-table">
                    <div class="cart-table-head">
                        <span>Etkinlik</span>
                        <span>Adet</span>
                        <span>Birim Fiyat</span>
                        <span>Toplam</span>
                        <span></span>
                    </div>

                    @foreach (var item in Model.Items)
                    {
                        <div class="cart-row">
                            <div>
                                <div class="cart-event-title">@item.EventTitle</div>
                                <div class="cart-event-meta">
                                    <i class="bi bi-geo-alt"></i> @item.VenueName &nbsp;·&nbsp;
                                    <i class="bi bi-calendar3"></i> @item.EventDate.ToString("dd MMM yyyy")
                                </div>
                            </div>
                            <div class="cart-qty-form">
                                <form asp-action="UpdateQuantity" method="post">
                                    <input type="hidden" name="eventId" value="@item.EventId" />
                                    <input type="number" name="quantity" value="@item.Quantity"
                                           min="1" max="20" class="cart-qty-input"
                                           onchange="this.form.submit()" />
                                </form>
                            </div>
                            <div class="cart-price">₺@item.TicketPrice.ToString("N0")</div>
                            <div class="cart-subtotal">₺@item.SubTotal.ToString("N0")</div>
                            <div>
                                <form asp-action="Remove" method="post">
                                    <input type="hidden" name="eventId" value="@item.EventId" />
                                    <button type="submit" class="cart-remove-btn" title="Kaldır"
                                            onclick="return confirm('Bu bileti sepetten kaldırmak istediğinizden emin misiniz?')">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>

                <form asp-action="Clear" method="post">
                    <button type="submit" class="cart-clear-btn"
                            onclick="return confirm('Sepeti temizlemek istediğinizden emin misiniz?')">
                        <i class="bi bi-x-circle"></i> Sepeti Temizle
                    </button>
                </form>
            </div>

            <div class="cart-summary">
                <div class="cart-summary-title">Sipariş Özeti</div>

                <div class="cart-summary-row">
                    <span>Toplam Bilet</span>
                    <span>@Model.TotalItems adet</span>
                </div>

                <div class="cart-summary-divider"></div>

                <div class="cart-summary-total">
                    <span class="cart-summary-total-label">Genel Toplam</span>
                    <span class="cart-summary-total-amount">₺@Model.TotalAmount.ToString("N0")</span>
                </div>

                <a asp-action="Checkout" class="cart-checkout-btn">
                    <i class="bi bi-credit-card"></i> Ödemeye Geç
                </a>
                <a asp-controller="Events" asp-action="Index" class="cart-continue-btn">
                    Alışverişe Devam Et
                </a>
            </div>
        }

    </div>
</div>
