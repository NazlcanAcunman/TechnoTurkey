@model EventTicket.UI.ViewComponents.CommentListComponentViewModel

<div class="et-comment-list">
    @if (Model.Comments.Any())
    {
        <div class="et-comment-summary mb-3">
            <span class="et-comment-avg">@Model.AverageRating / 5</span>
            <span class="et-comment-count">(@Model.Comments.Count yorum)</span>
        </div>
        @foreach (var c in Model.Comments)
        {
            <div class="et-comment-item glass-card p-3 mb-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <strong class="et-comment-author">@c.UserFullName</strong>
                    <span class="et-comment-date text-muted small">@c.CreatedAt.ToString("dd MMM yyyy")</span>
                </div>
                <div class="et-comment-stars mb-1">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <i class="bi @(i <= c.Rating ? "bi-star-fill" : "bi-star") text-warning"></i>
                    }
                </div>
                <p class="et-comment-content mb-0">@c.Content</p>
            </div>
        }
    }
    else
    {
        <p class="text-muted">Henüz yorum yapılmamış. İlk yorumu siz yapın!</p>
    }

    @if (User.Identity?.IsAuthenticated == true)
    {
        <form asp-controller="Comments" asp-action="Add" method="post" class="mt-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="EventId" value="@Model.NewComment.EventId" />
            <input type="hidden" name="VenueId" value="@Model.NewComment.VenueId" />
            <div class="mb-2">
                <label class="form-label small text-muted">Puanınız</label>
                <select name="Rating" class="form-select et-select-dark">
                    @for (int i = 5; i >= 1; i--)
                    {
                        <option value="@i">@i Yıldız</option>
                    }
                </select>
            </div>
            <div class="mb-2">
                <textarea name="Content" class="form-control et-input-dark" rows="3"
                          placeholder="Yorumunuzu yazın..." maxlength="1000" required></textarea>
            </div>
            <button type="submit" class="btn et-btn-primary btn-sm">Yorum Yap</button>
        </form>
    }
    else
    {
        <p class="mt-3 text-muted small">
            Yorum yapabilmek için <a asp-controller="Auth" asp-action="Login">giriş yapın</a>.
        </p>
    }
</div>
