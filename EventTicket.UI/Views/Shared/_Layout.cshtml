<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechnoTurkey</title>
    <link rel="icon" type="image/svg+xml" href="~/icon/favicon.svg" asp-append-version="true" />
    <link rel="alternate icon" type="image/jpeg" href="~/icon/favicon.jpg" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Anek+Latin:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/event.css" asp-append-version="true" />
</head>
<body>

    @inject EventTicket.UI.Services.IBannerUlService _bannerSvc
    @{ var _topBar = (await _bannerSvc.GetActiveAsync()).FirstOrDefault(b => b.Type == EventTicket.Core.Entities.BannerType.TopBar); }
    @if (_topBar != null)
    {
        var bg = string.IsNullOrEmpty(_topBar.BgColor) ? "#6c5ce7" : _topBar.BgColor;
        var fg = string.IsNullOrEmpty(_topBar.TextColor) ? "#ffffff" : _topBar.TextColor;
        <div class="et-banner" id="topBanner" style="background:@bg">
            <div class="et-banner-overlay">
                <div class="et-banner-text" style="color:@fg">
                    @if (!string.IsNullOrEmpty(_topBar.TagText))
                    {
                        <span class="et-banner-tag" style="color:@bg;background:@fg">@_topBar.TagText</span>
                    }
                    @_topBar.Title
                </div>
                <div style="display:flex;align-items:center;gap:12px;flex-shrink:0">
                    @if (!string.IsNullOrEmpty(_topBar.TicketUrl))
                    {
                        <a href="@_topBar.TicketUrl" class="et-banner-cta" style="color:@bg;background:@fg">@(string.IsNullOrEmpty(_topBar.SubTitle) ? "DETAY" : _topBar.SubTitle)</a>
                    }
                    <button onclick="document.getElementById('topBanner').style.display='none';document.documentElement.style.setProperty('--banner-h','0px')"
                            style="background:none;border:none;color:@fg;opacity:0.6;cursor:pointer;font-size:20px;padding:4px;line-height:1;flex-shrink:0">&times;</button>
                </div>
            </div>
        </div>
    }

    @await Html.PartialAsync("_Navbar")

    <main>
        @RenderBody()
    </main>

    @await Html.PartialAsync("_Footer")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await Html.PartialAsync("_NavbarScripts")
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>