@if (popArtists.Any())
{
<div class="et-section" style="background:rgba(255,255,255,.015);border-top:1px solid rgba(255,255,255,.04);border-bottom:1px solid rgba(255,255,255,.04)">
    <div class="et-section-header">
        <span class="et-section-title">Popüler Sanatçılar</span>
        <a asp-controller="Artists" asp-action="Index" class="et-section-more">Tümünü Gör →</a>
    </div>
    <div class="et-pop-row">
        @foreach (var pa in popArtists)
        {
            <div class="et-pop-card" onclick="showArtistModal('@pa.Name','@Html.Raw(pa.Genre)','@pa.ImageUrl','@Html.Raw(pa.Bio ?? pa.Genre)','@pa.Name','','@pa.Id')" style="cursor:pointer">
                <div class="et-pop-img"><img src="@pa.ImageUrl" alt="@pa.Name" /></div>
                <div class="et-pop-name">@pa.Name</div>
                <div class="et-pop-genre">@pa.Genre</div>
                <button class="et-pop-follow" onclick="event.stopPropagation();toggleFollow(this)"><i class="bi bi-person-plus"></i> Takip Et</button>
            </div>
        }
    </div>

    <!-- Sanatçı bilgi modalı -->
    <div id="artistModal" style="display:none;position:fixed;inset:0;z-index:9000;background:rgba(0,0,0,0.75);backdrop-filter:blur(6px)" onclick="closeArtistModal()">
        <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:#1a1a1a;border:1px solid rgba(255,255,255,0.1);border-radius:18px;width:min(480px,94vw);overflow:hidden" onclick="event.stopPropagation()">
            <div id="am-img" style="width:100%;height:220px;overflow:hidden;position:relative;background:#111">
                <img id="am-img-el" src="" style="width:100%;height:100%;object-fit:cover;opacity:0.7" />
                <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(26,26,26,1) 0%,transparent 60%)"></div>
                <button onclick="closeArtistModal()" style="position:absolute;top:14px;right:14px;background:rgba(0,0,0,0.5);border:1px solid rgba(255,255,255,0.15);border-radius:50%;width:32px;height:32px;color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:16px">&times;</button>
            </div>
            <div style="padding:20px 24px 28px">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:14px">
                    <div>
                        <div id="am-name" style="font-size:22px;font-weight:900;color:#fff;margin-bottom:4px"></div>
                        <div id="am-genre" style="font-size:10px;font-weight:800;letter-spacing:0.1em;color:#000;background:#fff;padding:3px 9px;border-radius:4px;display:inline-block"></div>
                    </div>
                </div>
                <div id="am-bio" style="font-size:13px;color:rgba(255,255,255,0.55);line-height:1.75;margin-bottom:18px"></div>
                <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07);border-radius:10px;padding:12px 16px;margin-bottom:18px">
                    <div style="font-size:10px;color:rgba(255,255,255,0.3);letter-spacing:0.06em;text-transform:uppercase;margin-bottom:8px">Yaklaşan Etkinlik</div>
                    <div id="am-event-title" style="font-size:14px;font-weight:700;color:#fff;margin-bottom:4px"></div>
                    <div id="am-event-date" style="font-size:12px;color:rgba(255,255,255,0.35)"><i class="bi bi-calendar3"></i> </div>
                </div>
                <div style="display:flex;gap:10px">
                    <a id="am-ticket-btn" href="#" class="et-hero-btn" style="flex:1;justify-content:center"><i class="bi bi-ticket-perforated"></i> BİLET AL</a>
                    <button onclick="toggleFollow(this);event.stopPropagation()" class="et-pop-follow" style="border-radius:10px;padding:12px 18px"><i class="bi bi-person-plus"></i> Takip Et</button>
                </div>
            </div>
        </div>
    </div>
</div>
}

