<style>
/* ─── All events grid ─── */
.et-all-grid {
    max-width: 1280px; margin: 0 auto; padding: 0 20px;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 18px;
}
@@media (max-width: 600px) { .et-all-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; padding: 0 12px; } }

/* ─── City filter tab bar ─── */
.et-city-tab-bar {
    background: rgba(0,0,0,0.85);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom: 1px solid rgba(255,255,255,0.07);
    position: sticky;
    top: calc(var(--banner-h, 72px) + 106px);
    z-index: 50;
}
.et-city-tab-inner {
    max-width: 1280px; margin: 0 auto; padding: 0 20px;
    display: flex; align-items: center; gap: 2px;
    overflow-x: auto; scrollbar-width: none;
}
.et-city-tab-inner::-webkit-scrollbar { display: none; }
.et-city-tab {
    display: flex; align-items: center; gap: 6px;
    font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: rgba(255,255,255,0.35);
    padding: 15px 18px;
    border: none; background: none; cursor: pointer;
    font-family: inherit; white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color 0.2s, border-color 0.2s;
}
.et-city-tab:hover { color: rgba(255,255,255,0.75); }
.et-city-tab.active { color: #fff; border-bottom-color: #fff; }

.et-city-section { display: none; }
.et-city-section.active { display: block; }

/* ─── City event cards ─── */
.et-ec {
    flex: 0 0 260px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 16px; overflow: hidden;
    display: flex; flex-direction: column;
    transition: transform 0.22s, border-color 0.22s, box-shadow 0.22s;
    color: inherit; text-decoration: none;
    box-shadow: 0 2px 12px rgba(0,0,0,0.5);
}
.et-ec:hover { transform: translateY(-6px); border-color: rgba(255,255,255,0.16); box-shadow: 0 0 0 1px rgba(255,255,255,0.08), 0 20px 56px rgba(0,0,0,0.9), 0 0 40px rgba(255,255,255,0.04); }
.et-ec-img { width: 100%; aspect-ratio: 1 / 1; overflow: hidden; flex-shrink: 0; background: #0d0d0d; }
.et-ec-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; display: block; }
.et-ec:hover .et-ec-img img { transform: scale(1.07); }
