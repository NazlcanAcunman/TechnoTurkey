    <div class="et-section">
        <div class="et-section-header">
            <span class="et-section-title"><span class="et-live-dot"></span>Bu Hafta</span>
            <a asp-controller="Events" asp-action="Index" class="et-section-more">TÜMÜNÜ GÖR →</a>
