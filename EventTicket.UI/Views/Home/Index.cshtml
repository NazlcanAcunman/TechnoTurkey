        var titleEl = wrap.closest('.et-section')?.querySelector('.et-section-title');
        var cityLabel = {istanbul:'İstanbul',izmir:'İzmir',ankara:'Ankara',bodrum:'Bodrum',cesme:'Çeşme'}[city] || 'Türkiye';
        if (titleEl) titleEl.textContent = 'TOP 10 – ' + cityLabel;
        wrap.innerHTML = data.map(function(e) {
            return '<a href="/Events?search=' + encodeURIComponent(e.search) + '" class="et-top10-row" style="text-decoration:none">' +
