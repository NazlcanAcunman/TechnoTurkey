                '<div class="et-top10-thumb"><img src="' + e.img + '" alt="' + e.title.replace(/"/g,'') + '" loading="lazy" /></div>' +
                '<div class="et-top10-info">' +
                    '<div class="et-top10-title">' + e.title + '</div>' +
                    '<div class="et-top10-meta"><i class="bi bi-calendar3"></i> ' + e.date + ' &nbsp;·&nbsp; <i class="bi bi-geo-alt"></i> ' + e.venue + '</div>' +
                '</div>' +
                '<span class="et-top10-btn"><i class="bi bi-ticket-perforated"></i> SATIN AL</span>' +
            '</a>';
        }).join('');
    }

    /* ── City tab switching ── */
    function switchCity(city, btn) {
        document.querySelectorAll('.et-city-section').forEach(s => s.classList.remove('active'));
        document.querySelectorAll('.et-city-tab').forEach(t => t.classList.remove('active'));
        document.getElementById('city-' + city).classList.add('active');
        btn.classList.add('active');
        renderTop10(city);
    }

    /* ── Section carousels ── */
    function sc(id, dir) {
        const el = document.getElementById(id);
        if (el) el.scrollBy({ left: dir * 270, behavior: 'smooth' });
    }

    /* ── Follow toggle ── */
    function toggleFollow(btn) {
        const on = btn.dataset.f === '1';
        btn.innerHTML = on ? '<i class="bi bi-person-plus"></i> Takip Et' : '<i class="bi bi-person-check-fill"></i> Takip Ediliyor';
        btn.style.background   = on ? '' : 'rgba(255,255,255,0.1)';
        btn.style.borderColor  = on ? '' : 'rgba(255,255,255,0.3)';
        btn.style.color        = on ? '' : '#fff';
        btn.dataset.f          = on ? '0' : '1';
    }

    /* ── Artist modal ── */
    function showArtistModal(name, genre, img, bio, eventTitle, eventDate, artistId) {
        document.getElementById('am-name').textContent = name;
        document.getElementById('am-genre').textContent = genre;
        document.getElementById('am-img-el').src = img;
        document.getElementById('am-bio').textContent = bio;
        document.getElementById('am-event-title').textContent = eventTitle;
        document.getElementById('am-event-date').innerHTML = '<i class="bi bi-calendar3"></i> ' + (eventDate || '');
        document.getElementById('am-ticket-btn').href = '/Events?search=' + encodeURIComponent(name);
        document.getElementById('artistModal').style.display = 'block';
        document.body.style.overflow = 'hidden';
    }

    function closeArtistModal() {
        document.getElementById('artistModal').style.display = 'none';
        document.body.style.overflow = '';
    }

    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeArtistModal(); });
</script>
}
