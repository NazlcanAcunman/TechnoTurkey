    let cur = 0;
    const slides = Array.from(document.querySelectorAll('.et-hero-slide'));
    const dots   = Array.from(document.querySelectorAll('.et-hero-dot'));

    function goToSlide(n) {
        slides[cur].classList.remove('et-slide-active');
        dots[cur]  && dots[cur].classList.remove('active');
        cur = ((n % slides.length) + slides.length) % slides.length;
        slides[cur].classList.add('et-slide-active');
        dots[cur]  && dots[cur].classList.add('active');
    }
    function heroArrow(d) { goToSlide(cur + d); }

    // İlk slide aktif
    slides[0]?.classList.add('et-slide-active');

    // Her slide için data-slide-url'den URL oku ve yönlendir
    slides.forEach(slide => {
        slide.addEventListener('click', function() {
            const url = this.dataset.slideUrl;
            if (url) location.href = url;
        });
    });

