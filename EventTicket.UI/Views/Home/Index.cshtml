@model List<EventTicket.UI.ViewModels.EventCardViewModel>
@using EventTicket.UI.ViewModels
@using EventTicket.Core.Entities
@{
    ViewData["Title"] = "Anasayfa";
    var artists  = ViewBag.Artists as List<ArtistCardViewModel> ?? new();
    var venues   = ViewBag.Venues  as List<VenueCardViewModel>  ?? new();
    var banners  = ViewBag.Banners as List<BannerViewModel>     ?? new();
    var now      = DateTime.Now;
    var thisWeek = Model.Where(e => e.Date >= now && e.Date <= now.AddDays(7)).ToList();

    // Banner data from database
    var heroSlides     = banners.Where(b => b.Type == BannerType.HeroSlide).OrderBy(b => b.SortOrder).ToList();
    var featuredBanner = banners.FirstOrDefault(b => b.Type == BannerType.FeaturedBanner)
                         ?? (heroSlides.Any() ? heroSlides[0] : null);
    var bannerSlide    = heroSlides.Any() ? heroSlides[0] : null;

    // Events from database
    var top10          = Model.OrderByDescending(e => e.SoldCount).Take(10).ToList();
    var featuredArtists = artists.Take(8).ToList();
    var newest         = Model.OrderByDescending(e => e.Date).Where(e => e.Date >= now).Take(8).ToList();
    var popArtists     = artists.Take(5).ToList();

    var venueImgMap = new Dictionary<string,string>(StringComparer.OrdinalIgnoreCase) {
        { "Klein Phönix",                          "https://cdn.bugece.co/e56b65a3-02a6-44bd-b968-7d721e51df2d" },
        { "Life Park",                             "https://cdn.bugece.co/77724539-d7a1-4999-9e1e-50fe62c951ba" },
        { "Ataköy Marina Arena",                   "https://cdn.bugece.co/85df50ee-660e-42a6-a253-9c1cb5406e08" },
        { "Volkswagen Arena",                      "https://cdn.bugece.co/6905f471-a658-4ca6-a185-bb307cb3ec7c" },
        { "KüçükÇiftlik Park",                     "https://cdn.bugece.co/cfe72717-fc72-416c-a348-3531651b9f11" },
        { "Zorlu PSM",                             "https://cdn.bugece.co/2c2ce7bb-1692-4d98-9eac-40412ca4e602" },
        { "Suma Han",                              "https://cdn.bugece.co/390cf8a4-064c-4f3b-a93a-891978565f81" },
        { "Harbiye Açıkhava Tiyatrosu",            "https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?w=400&q=80" },
        { "Babylon İstanbul",                      "https://images.unsplash.com/photo-1598387993441-a364f854959d?w=400&q=80" },
        { "Garajistanbul",                         "https://images.unsplash.com/photo-1493225457155-ac4c670f6513?w=400&q=80" },
        { "Ankara Arena",                          "https://images.unsplash.com/photo-1459749411175-04bf5292ceea?w=400&q=80" },
        { "Congresium Ankara",                     "https://images.unsplash.com/photo-1571266752173-c23b75dfbf18?w=400&q=80" },
        { "Ankara Atatürk Spor Salonu",            "https://images.unsplash.com/photo-1470225620780-dba8ba36b745?w=400&q=80" },
        { "İzmir Fuar Açıkhava",                   "https://images.unsplash.com/photo-1521537634581-0dced2fee2ef?w=400&q=80" },
        { "Bostanlı Suat Taşer Tiyatrosu",         "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=400&q=80" },
        { "Ege Üniversitesi Açıkhava",             "https://images.unsplash.com/photo-1533174072545-7a4b6ad7a6c3?w=400&q=80" },
        { "Antalya Expo Alanı",                    "https://images.unsplash.com/photo-1523580494863-6f3031224c94?w=400&q=80" },
        { "Regnum Sky Bar",                        "https://images.unsplash.com/photo-1429962714451-bb934ecdc4ec?w=400&q=80" },
        { "Bodrum Antik Tiyatro",                  "https://images.unsplash.com/photo-1504680177321-5ac30d97b29e?w=400&q=80" },
        { "Catamaran Bodrum",                      "https://images.unsplash.com/photo-1581961059174-d13f2f71d4ef?w=400&q=80" },
        { "Bursa Büyükşehir Belediyesi Açıkhava",  "https://images.unsplash.com/photo-1496337589254-7e19d01cec44?w=400&q=80" },
