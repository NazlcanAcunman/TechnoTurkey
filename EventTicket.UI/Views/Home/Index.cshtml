@if (bannerSlide != null)
{
    string fullbannerUrl = bannerSlide.EventId.HasValue
        ? "/Events/Details/" + bannerSlide.EventId
        : (!string.IsNullOrEmpty(bannerSlide.TicketUrl)
            ? bannerSlide.TicketUrl
            : (!string.IsNullOrEmpty(bannerSlide.SearchQuery)
                ? "/Events?search=" + Uri.EscapeDataString(bannerSlide.SearchQuery)
                : "/Events"));
<!-- ════ FULL VIEWPORT HERO BANNER ════ -->
<div class="et-fullbanner" onclick="location.href='@fullbannerUrl'" style="cursor:pointer">
    <img src="@bannerSlide.ImageUrl" alt="@bannerSlide.Title" class="et-fullbanner-bg">
    <div class="et-fullbanner-overlay"></div>
    <div class="et-fullbanner-content">
        <div class="et-fullbanner-badge">
            <i class="bi bi-calendar3"></i>@bannerSlide.DateText &nbsp;·&nbsp; @bannerSlide.Venue
        </div>
        <h1 class="et-fullbanner-title">@bannerSlide.Title</h1>
        <p class="et-fullbanner-sub">@bannerSlide.SubTitle</p>
        <a href="@fullbannerUrl" class="et-fullbanner-btn" onclick="event.stopPropagation()">
            <i class="bi bi-ticket-perforated"></i> BİLET AL
        </a>
    </div>
    <div class="et-fullbanner-scroll"><i class="bi bi-chevron-compact-down"></i></div>
</div>

<!-- ════ EN YENİ ETKİNLİKLER ════ -->
@if (newest.Any())
{
<div class="et-section">
    <div class="et-section-header">
        <span class="et-section-title">En Yeni Etkinlikler</span>
        <a asp-controller="Events" asp-action="Index" class="et-section-more">Tümünü Gör →</a>
    </div>
    <div class="et-carousel">
        <button class="et-carr-btn et-carr-l" onclick="sc('nw',-1)"><i class="bi bi-chevron-left"></i></button>
        <div class="et-scroll-wrap" id="nw">
            <div class="et-scroll-inner" style="gap:14px">
                @foreach (var n in newest)
                {
                    @await Html.PartialAsync("_EventCard", n)
                }
            </div>
        </div>
        <button class="et-carr-btn et-carr-r" onclick="sc('nw',1)"><i class="bi bi-chevron-right"></i></button>
    </div>
</div>
}

<!-- ════ COMPACT SLIDER ════ -->
<div class="et-hero-wrap">
<div class="et-hero">
    <div class="et-hero-slides" id="heroSlides">
        @foreach (var hs in heroSlides)
        {
            string hsUrl = hs.EventId.HasValue
                ? "/Events/Details/" + hs.EventId
                : (!string.IsNullOrEmpty(hs.TicketUrl)
                    ? hs.TicketUrl
                    : (!string.IsNullOrEmpty(hs.SearchQuery)
                        ? "/Events?search=" + Uri.EscapeDataString(hs.SearchQuery)
                        : "/Events"));
            <div class="et-hero-slide" data-slide-url="@hsUrl" style="cursor:pointer">
                <img src="@hs.ImageUrl" alt="@hs.Title" />
                <div class="et-hero-overlay">
                    <div class="et-hero-content">
                        <div class="et-hero-badge">
                            <i class="bi bi-calendar3"></i>
                            @hs.DateText &nbsp;·&nbsp; @hs.Venue
                        </div>
                        <div class="et-hero-title">@hs.Title</div>
                        <div class="et-hero-artist">@hs.SubTitle</div>
                        <div style="display:flex;gap:12px;align-items:center;margin-top:24px">
                            <a href="@hsUrl" class="et-hero-btn" onclick="event.stopPropagation()">
                                <i class="bi bi-ticket-perforated"></i> BİLET AL
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <button class="et-hero-arrow et-hero-arrow-left"  onclick="heroArrow(-1)" aria-label="Önceki"><i class="bi bi-chevron-left"></i></button>
    <button class="et-hero-arrow et-hero-arrow-right" onclick="heroArrow(1)"  aria-label="Sonraki"><i class="bi bi-chevron-right"></i></button>
    <div class="et-hero-dots" id="heroDots">
        @for (int i = 0; i < heroSlides.Count; i++)
        {
            <button class="et-hero-dot @(i == 0 ? "active" : "")" onclick="goToSlide(@i)"></button>
        }
    </div>
</div>
</div>
}


<!-- ════ TÜM ETKİNLİKLER ════ -->
@if (Model.Any())
{
<div class="et-section">
    <div class="et-section-header">
        <span class="et-section-title">Tüm Etkinlikler</span>
        <a asp-controller="Events" asp-action="Index" class="et-section-more">Tümünü Gör →</a>
    </div>
    <div class="et-all-grid">
        @foreach (var ev in Model.Where(e => e.Date >= now).OrderBy(e => e.Date))
        {
            @await Html.PartialAsync("_EventCard", ev)
        }
    </div>
</div>
}

<!-- ════ TOP 10 ════ -->
@if (top10.Any())
{
<div class="et-section">
    <div class="et-section-header">
        <span class="et-section-title">TOP 10 – En Çok Satan</span>
        <a asp-controller="Events" asp-action="Index" class="et-section-more">Tümünü Gör →</a>
    </div>
    <div class="et-top10-wrap">
        @{ int rank = 1; }
        @foreach (var e in top10)
        {
            <a href="/Events/Details/@e.Id" class="et-top10-row" style="text-decoration:none" target="_blank">
                <span class="et-top10-rank @(rank <= 3 ? "gold" : "")">@rank</span>
                <div class="et-top10-thumb">
                    <img src="@e.ImageUrl" alt="@e.Title" />
                </div>
                <div class="et-top10-info">
                    <div class="et-top10-title">@e.Title</div>
                    <div class="et-top10-meta"><i class="bi bi-calendar3"></i> @e.Date.ToString("dd MMM yyyy") &nbsp;·&nbsp; <i class="bi bi-geo-alt"></i> @e.VenueName</div>
                </div>
                <span class="et-top10-btn"><i class="bi bi-ticket-perforated"></i> SATIN AL</span>
            </a>
            rank++;
        }
    </div>
</div>
}

@if (featuredArtists.Any())
{
<div class="et-section" style="background:rgba(255,255,255,.012);border-top:1px solid rgba(255,255,255,.04);border-bottom:1px solid rgba(255,255,255,.04)">
    <div class="et-section-header">
        <span class="et-section-title">Öne Çıkan Sanatçılar</span>
        <a asp-controller="Artists" asp-action="Index" class="et-section-more">Tümünü Gör →</a>
    </div>
    <div class="et-carousel">
        <button class="et-carr-btn et-carr-l" onclick="sc('aw',-1)"><i class="bi bi-chevron-left"></i></button>
        <div class="et-scroll-wrap" id="aw">
            <div class="et-scroll-inner" style="gap:14px">
                @foreach (var a in featuredArtists)
                {
                    <div class="et-ac">
                        <a href="/Events?search=@Uri.EscapeDataString(a.Name)" style="text-decoration:none">
                            <div class="et-ac-img">
                                <img src="@a.ImageUrl" alt="@a.Name" />
                                <span class="et-ac-genre">@a.Genre</span>
                            </div>
                        </a>
                        <div class="et-ac-body">
                            <a href="/Events?search=@Uri.EscapeDataString(a.Name)" style="text-decoration:none">
                                <div class="et-ac-name">@a.Name</div>
                                <div class="et-ac-sub">@a.Genre</div>
                            </a>
                            <a href="/Events?search=@Uri.EscapeDataString(a.Name)" class="et-ac-btn" style="text-decoration:none"><i class="bi bi-music-note-list"></i> ETKİNLİKLERİ GÖR</a>
                        </div>
                    </div>
                }
            </div>
        </div>
        <button class="et-carr-btn et-carr-r" onclick="sc('aw',1)"><i class="bi bi-chevron-right"></i></button>
    </div>
</div>
}

@if (featuredBanner != null)
{
    string fbUrl = featuredBanner.EventId.HasValue
        ? "/Events/Details/" + featuredBanner.EventId
        : (!string.IsNullOrEmpty(featuredBanner.TicketUrl)
            ? featuredBanner.TicketUrl
            : (!string.IsNullOrEmpty(featuredBanner.SearchQuery)
                ? "/Events?search=" + Uri.EscapeDataString(featuredBanner.SearchQuery)
                : "/Events"));
<div class="et-banner-section">
    <div class="et-banner-inner" onclick="location.href='@fbUrl'" style="cursor:pointer">
        <img src="@featuredBanner.ImageUrl" alt="@featuredBanner.Title" />
        <div class="et-feat-overlay">
            <div class="et-banner-content">
                <div class="et-hero-badge" style="margin-bottom:18px;font-size:11px;padding:6px 16px">
                    <i class="bi bi-lightning-charge-fill" style="color:#fff"></i> ÖNE ÇIKAN ETKİNLİK
                </div>
                <div class="et-banner-title">@featuredBanner.Title</div>
                @if (!string.IsNullOrEmpty(featuredBanner.SubTitle))
                {
                    <div style="font-size:15px;font-weight:400;color:rgba(255,255,255,0.6);margin-bottom:16px;letter-spacing:0.04em">@featuredBanner.SubTitle</div>
                }
                <div class="et-banner-meta">
                    @if (!string.IsNullOrEmpty(featuredBanner.DateText))
                    {
                        <span><i class="bi bi-calendar3"></i> @featuredBanner.DateText</span>
                    }
                    @if (!string.IsNullOrEmpty(featuredBanner.Venue))
                    {
                        <span>&nbsp;·&nbsp; <i class="bi bi-geo-alt"></i> @featuredBanner.Venue</span>
                    }
                </div>
                <div style="display:flex;gap:12px;align-items:center;margin-top:28px;flex-wrap:wrap">
                    <a href="@fbUrl" class="et-hero-btn" onclick="event.stopPropagation()">
                        <i class="bi bi-ticket-perforated"></i> BİLET AL
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
}

@if (thisWeek.Any())
