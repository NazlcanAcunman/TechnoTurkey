@{
    ViewData["Title"] = "Ayarlar";
}

<style>
    .settings-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 20px;
    }

    .settings-card {
        background: #1a1a1a;
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 14px;
        padding: 24px;
    }

    .settings-card-title {
        font-size: 13px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .settings-card-desc {
        font-size: 12px;
        color: rgba(255,255,255,0.3);
        margin-bottom: 20px;
        line-height: 1.6;
    }

    .settings-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-bottom: 14px;
    }

    .settings-field label {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.06em;
        color: rgba(255,255,255,0.4);
        text-transform: uppercase;
    }

    .settings-field input,
    .settings-field select,
    .settings-field textarea {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 8px;
        padding: 10px 14px;
        color: #fff;
        font-size: 13px;
        font-family: inherit;
        outline: none;
        transition: border-color 0.2s;
        width: 100%;
    }

    .settings-field input:focus,
    .settings-field select:focus,
    .settings-field textarea:focus {
        border-color: rgba(255,255,255,0.3);
    }

    .settings-field input::placeholder,
    .settings-field textarea::placeholder {
        color: rgba(255,255,255,0.2);
    }

    .settings-save-btn {
        background: #fff;
        color: #000;
        border: none;
        border-radius: 8px;
        padding: 10px 22px;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.07em;
        cursor: pointer;
        font-family: inherit;
        transition: opacity 0.2s;
        margin-top: 8px;
    }

    .settings-save-btn:hover { opacity: 0.85; }

    .settings-toggle-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .settings-toggle-row:last-child { border-bottom: none; }

    .settings-toggle-label {
        font-size: 13px;
        color: rgba(255,255,255,0.7);
    }

    .settings-toggle-sub {
        font-size: 11px;
        color: rgba(255,255,255,0.3);
        margin-top: 2px;
    }

    .settings-toggle {
        position: relative;
        width: 40px;
        height: 22px;
        flex-shrink: 0;
    }

    .settings-toggle input { opacity: 0; width: 0; height: 0; }

    .settings-toggle-slider {
        position: absolute;
        inset: 0;
        background: rgba(255,255,255,0.1);
        border-radius: 22px;
        cursor: pointer;
        transition: background 0.2s;
    }

    .settings-toggle-slider::before {
        content: '';
        position: absolute;
        width: 16px;
        height: 16px;
        left: 3px;
        top: 3px;
        background: rgba(255,255,255,0.5);
        border-radius: 50%;
        transition: transform 0.2s, background 0.2s;
    }

    .settings-toggle input:checked + .settings-toggle-slider { background: #fff; }
    .settings-toggle input:checked + .settings-toggle-slider::before {
        transform: translateX(18px);
        background: #111;
    }

    .settings-info-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        font-size: 13px;
    }

    .settings-info-row:last-child { border-bottom: none; }
    .settings-info-key { color: rgba(255,255,255,0.4); }
    .settings-info-val { color: #fff; font-weight: 600; }
</style>

<div class="settings-grid">

    <!-- Site Bilgileri -->
    <div class="settings-card">
        <div class="settings-card-title">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.6)" stroke-width="2">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            </svg>
            Site Bilgileri
        </div>
        <div class="settings-card-desc">Platformun temel ayarlarını buradan yönetin.</div>

        <div class="settings-field">
            <label>Site Adı</label>
            <input type="text" value="TechnoTurkey" placeholder="Site adı" />
        </div>
        <div class="settings-field">
            <label>İletişim E-postası</label>
            <input type="email" placeholder="ornek@technoturkey.net" />
        </div>
        <div class="settings-field">
            <label>Destek Telefonu</label>
            <input type="tel" placeholder="+90 555 000 00 00" />
        </div>
        <button class="settings-save-btn" onclick="showToast('Site bilgileri kaydedildi.')">KAYDET</button>
    </div>

    <!-- Bildirim Ayarları -->
    <div class="settings-card">
        <div class="settings-card-title">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.6)" stroke-width="2">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
            </svg>
            Bildirim Ayarları
        </div>
        <div class="settings-card-desc">Kullanıcılara gönderilecek bildirimleri yapılandırın.</div>

        <div class="settings-toggle-row">
            <div>
                <div class="settings-toggle-label">E-posta Bildirimleri</div>
                <div class="settings-toggle-sub">Bilet satın alma onayı vb.</div>
            </div>
            <label class="settings-toggle">
                <input type="checkbox" checked />
                <span class="settings-toggle-slider"></span>
            </label>
        </div>
        <div class="settings-toggle-row">
            <div>
                <div class="settings-toggle-label">Yeni Etkinlik Bildirimi</div>
                <div class="settings-toggle-sub">Takip edilen sanatçılar için</div>
            </div>
            <label class="settings-toggle">
                <input type="checkbox" checked />
                <span class="settings-toggle-slider"></span>
            </label>
        </div>
        <div class="settings-toggle-row">
            <div>
                <div class="settings-toggle-label">Onay Bildirimi</div>
                <div class="settings-toggle-sub">İçerik onay/ret işlemleri</div>
            </div>
            <label class="settings-toggle">
                <input type="checkbox" checked />
                <span class="settings-toggle-slider"></span>
            </label>
        </div>
        <div class="settings-toggle-row">
            <div>
                <div class="settings-toggle-label">Pazarlama E-postaları</div>
                <div class="settings-toggle-sub">Kampanya ve duyurular</div>
            </div>
            <label class="settings-toggle">
                <input type="checkbox" />
                <span class="settings-toggle-slider"></span>
            </label>
        </div>
    </div>

    <!-- Güvenlik -->
    <div class="settings-card">
        <div class="settings-card-title">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.6)" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            Güvenlik
        </div>
        <div class="settings-card-desc">Hesap güvenliği ve erişim ayarları.</div>

        <div class="settings-field">
            <label>Mevcut Şifre</label>
            <input type="password" placeholder="••••••••" />
        </div>
        <div class="settings-field">
            <label>Yeni Şifre</label>
            <input type="password" placeholder="••••••••" />
        </div>
        <div class="settings-field">
            <label>Yeni Şifre Tekrar</label>
            <input type="password" placeholder="••••••••" />
        </div>
        <button class="settings-save-btn" onclick="showToast('Şifre güncellendi.')">ŞİFRE GÜNCELLE</button>
    </div>

    <!-- Sistem Bilgisi -->
    <div class="settings-card">
        <div class="settings-card-title">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.6)" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            Sistem Bilgisi
        </div>
        <div class="settings-card-desc">Platform teknik bilgileri.</div>

        <div class="settings-info-row">
            <span class="settings-info-key">Versiyon</span>
            <span class="settings-info-val">1.0.0</span>
        </div>
        <div class="settings-info-row">
            <span class="settings-info-key">Ortam</span>
            <span class="settings-info-val" style="color:#4ade80">Production</span>
        </div>
        <div class="settings-info-row">
            <span class="settings-info-key">Oturum Açan</span>
            <span class="settings-info-val">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</span>
        </div>
        <div class="settings-info-row">
            <span class="settings-info-key">Rol</span>
            <span class="settings-info-val">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
        </div>
        <div class="settings-info-row">
            <span class="settings-info-key">Tarih</span>
            <span class="settings-info-val">@DateTime.Now.ToString("dd.MM.yyyy HH:mm")</span>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        function showToast(msg) {
            var t = document.createElement('div');
            t.textContent = msg;
            t.style.cssText = 'position:fixed;bottom:24px;right:24px;background:#1a1a1a;border:1px solid rgba(255,255,255,0.1);border-radius:10px;padding:12px 20px;font-size:13px;color:#fff;z-index:9999;box-shadow:0 20px 40px rgba(0,0,0,0.5);animation:fadeIn 0.3s';
            document.body.appendChild(t);
            setTimeout(function(){ t.remove(); }, 2500);
        }
    </script>
}
