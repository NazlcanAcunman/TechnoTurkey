@model List<EventTicket.UI.ViewModels.AcademyContentViewModel>
@using System.Text.Json
@{
    ViewData["Title"] = "Akademi Yönetimi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<!-- Yeni İçerik Ekle -->
<div class="admin-table-wrap" style="margin-bottom:32px">
    <div class="admin-table-header">
        <span class="admin-table-title">Yeni İçerik Ekle</span>
    </div>
    <div style="padding:24px">
        <form asp-area="Admin" asp-controller="Academy" asp-action="Create" method="post">
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px;margin-bottom:16px">
                <div>
                    <label style="font-size:12px;color:rgba(255,255,255,0.5);font-weight:600;display:block;margin-bottom:6px">TÜR</label>
                    <input type="text" id="academyTypeInput" name="Type" required list="academyTypeList" placeholder="tür yazın (örn: instructor)"
                           style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:8px;color:#fff;padding:10px 12px;font-size:13px;font-family:inherit;box-sizing:border-box" />
                    <datalist id="academyTypeList">
                        <option value="info">Hakkımızda</option>
                        <option value="photo">Fotoğraf</option>
                        <option value="student">Öğrenci</option>
                        <option value="video">Video</option>
                        <option value="instructor">Eğitmen</option>
                        <option value="course">Eğitim</option>
                        <option value="workshop">Workshop</option>
                        <option value="faq">Sık Sorulan Soru</option>
                        <option value="testimonial">Başarı Hikayesi</option>
                        <option value="certificate">Sertifika</option>
                    </datalist>
                </div>
                <div>
                    <label style="font-size:12px;color:rgba(255,255,255,0.5);font-weight:600;display:block;margin-bottom:6px">BAŞLIK</label>
                    <input type="text" name="Title" required placeholder="Başlık girin..."
                           style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:8px;color:#fff;padding:10px 12px;font-size:13px;font-family:inherit;box-sizing:border-box" />
                </div>
                <div id="fieldMediaUrl">
                    <label style="font-size:12px;color:rgba(255,255,255,0.5);font-weight:600;display:block;margin-bottom:6px">GÖRSEL</label>
                    <input type="file" id="mediaFileInput" accept="image/*"
                           style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:8px;color:#fff;padding:8px 10px;font-size:12px;font-family:inherit;box-sizing:border-box" />
                    <input type="hidden" name="MediaUrl" id="mediaUrlHidden" />
                    <div id="mediaUploadStatus" style="font-size:11px;color:rgba(255,255,255,0.4);margin-top:6px"></div>
                </div>
                <div id="fieldLinkUrl">
                    <label style="font-size:12px;color:rgba(255,255,255,0.5);font-weight:600;display:block;margin-bottom:6px">LİNK <span style="font-weight:400;color:rgba(255,255,255,0.35)">(Instagram, web sitesi vb.)</span></label>
                    <input type="text" name="LinkUrl" placeholder="https://instagram.com/kullaniciadi"
                           style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:8px;color:#fff;padding:10px 12px;font-size:13px;font-family:inherit;box-sizing:border-box" />
                </div>
                <div>
                    <label style="font-size:12px;color:rgba(255,255,255,0.5);font-weight:600;display:block;margin-bottom:6px">SIRA</label>
                    <input type="number" name="DisplayOrder" value="0" min="0"
                           style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:8px;color:#fff;padding:10px 12px;font-size:13px;font-family:inherit;box-sizing:border-box" />
                </div>
            </div>
            <div id="fieldDescription" style="margin-bottom:16px">
                <label style="font-size:12px;color:rgba(255,255,255,0.5);font-weight:600;display:block;margin-bottom:6px">AÇIKLAMA</label>
                <textarea name="Description" rows="3" placeholder="Açıklama girin..."
                          style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:8px;color:#fff;padding:10px 12px;font-size:13px;font-family:inherit;box-sizing:border-box;resize:vertical"></textarea>
            </div>
            <div style="display:flex;align-items:center;gap:20px">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;color:rgba(255,255,255,0.7)">
                    <input type="checkbox" name="IsActive" value="true" checked style="width:16px;height:16px;accent-color:#7c3aed" />
                    Aktif
                </label>
                <button type="submit" class="btn-admin btn-primary">
                    + İçerik Ekle
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Mevcut İçerikler -->
<div class="admin-table-wrap">
    <div class="admin-table-header">
        <span class="admin-table-title">Mevcut İçerikler</span>
        <span style="font-size:12px;color:rgba(255,255,255,0.35)">@Model.Count adet</span>
    </div>
    @if (!Model.Any())
    {
        <div style="padding:40px;text-align:center;color:rgba(255,255,255,0.3);font-size:14px">
            Henüz içerik eklenmemiş.
        </div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Tür</th>
                    <th>Başlık</th>
                    <th>Medya URL</th>
                    <th>Sıra</th>
                    <th>Aktif</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderBy(x => x.DisplayOrder))
                {
                    <tr>
                        <td>
                            @{
                                var badgeColor = item.Type switch
                                {
                                    "info"        => "#3b82f6",
                                    "photo"       => "#10b981",
                                    "student"     => "#f59e0b",
                                    "video"       => "#ef4444",
                                    "instructor"  => "#ec4899",
                                    "course"      => "#8b5cf6",
                                    "workshop"    => "#06b6d4",
                                    "faq"         => "#84cc16",
                                    "testimonial" => "#f97316",
                                    "certificate" => "#eab308",
                                    _             => "#6b7280"
                                };
                            }
                            <span style="background:@(badgeColor)22;color:@badgeColor;border:1px solid @(badgeColor)44;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;text-transform:uppercase">
                                @item.Type
                            </span>
                        </td>
                        <td style="font-weight:600;color:#fff">@item.Title</td>
                        <td style="color:rgba(255,255,255,0.45);font-size:12px;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                            @(string.IsNullOrEmpty(item.MediaUrl) ? "—" : (item.MediaUrl.Length > 40 ? item.MediaUrl.Substring(0, 40) + "…" : item.MediaUrl))
                        </td>
                        <td style="color:rgba(255,255,255,0.6)">@item.DisplayOrder</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span style="color:#10b981;font-size:16px">&#10003;</span>
                            }
                            else
                            {
                                <span style="color:rgba(255,255,255,0.2);font-size:16px">&#10005;</span>
                            }
                        </td>
                        <td style="display:flex;align-items:center;gap:8px">
                            <button type="button" class="btn-admin btn-sm"
                                    data-item="@JsonSerializer.Serialize(new {
                                        item.Id, item.Type, item.Title, item.Description,
                                        item.MediaUrl, item.LinkUrl, item.DisplayOrder, item.IsActive
                                    })"
                                    onclick="openEditModal(this)">Düzenle</button>
                            <form asp-area="Admin" asp-controller="Academy" asp-action="Delete" method="post"
                                  onsubmit="confirmDelete(this, '@item.Title içeriğini silmek istediğinize emin misiniz?'); return false;">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn-admin btn-danger btn-sm">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- ════ DÜZENLEME MODALI ════ -->
<div id="editModalOverlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:1000;align-items:center;justify-content:center;padding:20px">
    <div style="background:#141414;border:1px solid rgba(255,255,255,0.1);border-radius:14px;padding:28px;max-width:640px;width:100%;max-height:88vh;overflow-y:auto">
        <h3 style="color:#fff;margin:0 0 20px;font-size:16px;font-weight:700">İçeriği Düzenle</h3>
        <form asp-area="Admin" asp-controller="Academy" asp-action="Update" method="post">
            <input type="hidden" name="Id" id="editId" />
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px;margin-bottom:16px">
                <div>
                    <label style="font-size:12px;color:rgba(255,255,255,0.5);font-weight:600;display:block;margin-bottom:6px">TÜR</label>
                    <input type="text" id="editTypeInput" name="Type" required list="academyTypeList"
                           style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:8px;color:#fff;padding:10px 12px;font-size:13px;font-family:inherit;box-sizing:border-box" />
                </div>
                <div>
                    <label style="font-size:12px;color:rgba(255,255,255,0.5);font-weight:600;display:block;margin-bottom:6px">BAŞLIK</label>
                    <input type="text" name="Title" id="editTitle" required
                           style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:8px;color:#fff;padding:10px 12px;font-size:13px;font-family:inherit;box-sizing:border-box" />
                </div>
                <div id="editFieldMediaUrl">
                    <label style="font-size:12px;color:rgba(255,255,255,0.5);font-weight:600;display:block;margin-bottom:6px">GÖRSEL</label>
                    <input type="file" id="editMediaFileInput" accept="image/*"
                           style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:8px;color:#fff;padding:8px 10px;font-size:12px;font-family:inherit;box-sizing:border-box" />
                    <input type="hidden" name="MediaUrl" id="editMediaUrlHidden" />
                    <div id="editMediaUploadStatus" style="font-size:11px;color:rgba(255,255,255,0.4);margin-top:6px"></div>
                </div>
                <div id="editFieldLinkUrl">
                    <label style="font-size:12px;color:rgba(255,255,255,0.5);font-weight:600;display:block;margin-bottom:6px">LİNK <span style="font-weight:400;color:rgba(255,255,255,0.35)">(Instagram, web sitesi vb.)</span></label>
                    <input type="text" name="LinkUrl" id="editLinkUrl"
                           style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:8px;color:#fff;padding:10px 12px;font-size:13px;font-family:inherit;box-sizing:border-box" />
                </div>
                <div>
                    <label style="font-size:12px;color:rgba(255,255,255,0.5);font-weight:600;display:block;margin-bottom:6px">SIRA</label>
                    <input type="number" name="DisplayOrder" id="editDisplayOrder" min="0"
                           style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:8px;color:#fff;padding:10px 12px;font-size:13px;font-family:inherit;box-sizing:border-box" />
                </div>
            </div>
            <div id="editFieldDescription" style="margin-bottom:16px">
                <label style="font-size:12px;color:rgba(255,255,255,0.5);font-weight:600;display:block;margin-bottom:6px">AÇIKLAMA</label>
                <textarea name="Description" id="editDescription" rows="3"
                          style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:8px;color:#fff;padding:10px 12px;font-size:13px;font-family:inherit;box-sizing:border-box;resize:vertical"></textarea>
            </div>
            <label style="display:flex;align-items:center;gap:8px;color:rgba(255,255,255,0.7);font-size:13px;margin-bottom:20px">
                <input type="hidden" name="IsActive" value="false" />
                <input type="checkbox" name="IsActive" id="editIsActive" value="true" style="width:16px;height:16px" />
                Aktif
            </label>
            <div style="display:flex;gap:10px">
                <button type="submit" class="btn-admin">Kaydet</button>
                <button type="button" class="btn-admin" style="background:rgba(255,255,255,0.08);color:rgba(255,255,255,0.7)" onclick="closeEditModal()">İptal</button>
            </div>
        </form>
    </div>
</div>

<script>
    // Her tür için hangi alanların görünmesi gerektiğini tanımlar (create + edit ortak).
    var typeFieldMap = {
        "info":        ["description"],
        "photo":       ["mediaurl"],
        "student":     ["mediaurl", "description"],
        "video":       ["mediaurl", "description"],
        "instructor":  ["mediaurl", "linkurl"],
        "course":      ["mediaurl", "description", "linkurl"],
        "workshop":    ["mediaurl", "description", "linkurl"],
        "faq":         ["description"],
        "testimonial": ["mediaurl", "description"],
        "certificate": ["mediaurl"]
    };
    var allFields = ["mediaurl", "linkurl", "description"];

    function setupTypeVisibility(typeInput, fieldEls) {
        if (!typeInput) return;
        function update() {
            var typeKey = (typeInput.value || "").trim().toLowerCase();
            var visibleFields = typeFieldMap[typeKey] || allFields;
            allFields.forEach(function (f) {
                if (fieldEls[f]) {
                    fieldEls[f].style.display = visibleFields.indexOf(f) !== -1 ? "" : "none";
                }
            });
        }
        typeInput.addEventListener("input", update);
        update();
    }

    function setupMediaUpload(fileInput, hiddenInput, statusEl) {
        if (!fileInput) return;
        fileInput.addEventListener("change", function () {
            var f = this.files[0];
            if (!f) return;

            statusEl.textContent = "Yükleniyor...";
            statusEl.style.color = "rgba(255,255,255,0.4)";
            hiddenInput.value = "";

            var fd = new FormData();
            fd.append("file", f);

            fetch("@Url.Action("UploadImage", "Academy", new { area = "Admin" })", {
                method: "POST",
                body: fd
            })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (data.success) {
                        hiddenInput.value = data.url;
                        statusEl.textContent = "Yüklendi ✓";
                        statusEl.style.color = "#10b981";
                    } else {
                        statusEl.textContent = data.message || "Yükleme hatası oluştu.";
                        statusEl.style.color = "#ef4444";
                    }
                })
                .catch(function () {
                    statusEl.textContent = "Bağlantı hatası.";
                    statusEl.style.color = "#ef4444";
                });
        });
    }

    (function () {
        setupTypeVisibility(document.getElementById("academyTypeInput"), {
            mediaurl: document.getElementById("fieldMediaUrl"),
            linkurl: document.getElementById("fieldLinkUrl"),
            description: document.getElementById("fieldDescription")
        });
        setupMediaUpload(
            document.getElementById("mediaFileInput"),
            document.getElementById("mediaUrlHidden"),
            document.getElementById("mediaUploadStatus")
        );

        setupTypeVisibility(document.getElementById("editTypeInput"), {
            mediaurl: document.getElementById("editFieldMediaUrl"),
            linkurl: document.getElementById("editFieldLinkUrl"),
            description: document.getElementById("editFieldDescription")
        });
        setupMediaUpload(
            document.getElementById("editMediaFileInput"),
            document.getElementById("editMediaUrlHidden"),
            document.getElementById("editMediaUploadStatus")
        );
    })();

    function openEditModal(btn) {
        var item = JSON.parse(btn.getAttribute("data-item"));

        document.getElementById("editId").value = item.Id;
        document.getElementById("editTypeInput").value = item.Type || "";
        document.getElementById("editTitle").value = item.Title || "";
        document.getElementById("editMediaUrlHidden").value = item.MediaUrl || "";
        document.getElementById("editLinkUrl").value = item.LinkUrl || "";
        document.getElementById("editDisplayOrder").value = item.DisplayOrder || 0;
        document.getElementById("editDescription").value = item.Description || "";
        document.getElementById("editIsActive").checked = !!item.IsActive;
        document.getElementById("editMediaUploadStatus").textContent = item.MediaUrl ? "Mevcut görsel korunuyor (değiştirmek için yeni dosya seçin)" : "";
        document.getElementById("editMediaUploadStatus").style.color = "rgba(255,255,255,0.4)";

        // tür değiştiğinde alan görünürlüğünü güncelle
        document.getElementById("editTypeInput").dispatchEvent(new Event("input"));

        document.getElementById("editModalOverlay").style.display = "flex";
    }

    function closeEditModal() {
        document.getElementById("editModalOverlay").style.display = "none";
    }
</script>
