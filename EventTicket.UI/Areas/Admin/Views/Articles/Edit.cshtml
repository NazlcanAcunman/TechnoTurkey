@model EventTicket.UI.ViewModels.ArticleViewModel
@{
    ViewData["Title"] = "Makale Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var tags = new[] { "Haber", "Röportaj", "Festival", "Mekan", "Müzik", "Sanatçı", "Techno", "Trend", "Elektronik", "DJ", "Konser", "Özel" };
}

<div class="admin-table-wrap" style="max-width:860px">
    <div class="admin-table-header">
        <span class="admin-table-title">Düzenle — @Model.Title</span>
        <a asp-action="Index" class="btn-admin btn-sm" style="background:#444">← Geri</a>
    </div>

    <div style="padding:28px">
        @if (TempData["Success"] != null)
        {
            <div style="background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.2);border-radius:8px;padding:12px 16px;margin-bottom:20px;color:#4ade80;font-size:13px">✓ @TempData["Success"]</div>
        }

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div style="margin-bottom:18px">
                <label class="admin-field-label">Başlık *</label>
                <input asp-for="Title" class="admin-field-input" />
            </div>

            <div style="margin-bottom:18px">
                <label class="admin-field-label">Kategori / Etiket</label>
                <input type="hidden" asp-for="Tag" id="articleTag" />
                <div style="display:flex;flex-wrap:wrap;gap:7px;margin-bottom:10px">
                    @foreach (var t in tags)
                    {
                        <button type="button" class="tag-preset-btn @(Model.Tag == t ? "active" : "")" onclick="setArticleTag('@t')">@t</button>
                    }
                </div>
                <input type="text" id="articleTagCustom" class="admin-field-input" placeholder="Özel etiket yaz..."
                       value="@(!tags.Contains(Model.Tag) ? Model.Tag : "")"
                       oninput="setArticleTagFromInput(this.value)" style="max-width:260px;margin-bottom:12px" />
                <input type="hidden" asp-for="TagColor" id="articleTagColor" value="@(Model.TagColor ?? "#ffffff")" />
                <div>
                    <div class="admin-field-label" style="margin-bottom:8px">Etiket Rengi</div>
                    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                        @{ var currentColor = Model.TagColor ?? "#ffffff"; }
                        @foreach (var hex in new[] { "#ef4444","#f97316","#eab308","#22c55e","#3b82f6","#8b5cf6","#ec4899","#ffffff","#000000" })
                        {
                            <button type="button" class="tag-color-swatch @(hex == currentColor ? "active" : "")" data-color="@hex"
                                    style="width:26px;height:26px;border-radius:50%;background:@hex;
                                           border:@(hex==currentColor?"2px solid rgba(255,255,255,0.9)":hex=="#ffffff"?"2px solid rgba(255,255,255,0.4)":hex=="#000000"?"2px solid rgba(255,255,255,0.2)":"2px solid transparent");
                                           cursor:pointer;transition:all 0.15s"
                                    onclick="selectTagColor('@hex')"></button>
                        }
                        @{ var prevFg = (currentColor=="#ffffff"||currentColor=="#eab308") ? "#000" : "#fff"; }
                        <span id="tagColorPreview" style="margin-left:6px;font-size:11px;font-weight:700;padding:3px 10px;border-radius:100px;background:@currentColor;color:@prevFg">@Model.Tag</span>
                    </div>
                </div>
            </div>

            <div style="margin-bottom:18px">
                <label class="admin-field-label">Yazar</label>
                <input asp-for="Author" class="admin-field-input" />
            </div>

            <div style="margin-bottom:18px">
                <label class="admin-field-label">Kapak Görseli</label>
                <div class="upload-wrap" style="display:flex;gap:8px;align-items:center">
                    <input asp-for="ImageUrl" id="articleImageUrl" class="admin-field-input" style="flex:1" />
                    <label class="upload-btn btn-admin btn-sm" style="cursor:pointer;white-space:nowrap;flex-shrink:0">
                        Fotoğraf Yükle
                        <input type="file" accept="image/*" style="display:none" onchange="uploadToCloudinary(this,'articleImageUrl','articleImgPreview')" />
                    </label>
                </div>
                <img id="articleImgPreview" src="@Model.ImageUrl" alt="" style="@(string.IsNullOrEmpty(Model.ImageUrl) ? "display:none;" : "")margin-top:10px;max-height:120px;border-radius:8px;object-fit:cover" />
            </div>

            <div style="margin-bottom:18px">
                <label class="admin-field-label">Özet</label>
                <textarea asp-for="Summary" class="admin-field-input" rows="2"></textarea>
            </div>

            <div style="margin-bottom:18px">
                <label class="admin-field-label">İçerik</label>
                <textarea asp-for="Content" class="admin-field-input" rows="12"></textarea>
            </div>

            <div style="margin-bottom:18px">
                <div style="display:flex;align-items:center;padding-bottom:2px">
                    <label style="display:flex;align-items:center;gap:10px;cursor:pointer">
                        <input asp-for="IsPublished" type="checkbox" style="width:16px;height:16px;cursor:pointer" />
                        <span class="admin-field-label" style="margin:0">Yayınla</span>
                    </label>
                </div>
            </div>

            <div style="display:flex;gap:10px;margin-top:8px">
                <button type="submit" class="btn-admin" style="background:#fff;color:#000">✓ Kaydet</button>
                <a asp-action="Index" class="btn-admin" style="background:#444">İptal</a>
            </div>
        </form>
    </div>
</div>

<style>
.admin-field-label { display:block;font-size:11px;font-weight:700;letter-spacing:0.07em;color:rgba(255,255,255,0.4);text-transform:uppercase;margin-bottom:7px }
.admin-field-input { width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:8px;padding:10px 13px;color:#fff;font-size:13px;font-family:inherit;outline:none;box-sizing:border-box }
.admin-field-input:focus { border-color:rgba(255,255,255,0.25) }
.admin-field-input option { background:#1a1a1a }
.tag-preset-btn { background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);border-radius:100px;padding:5px 14px;color:rgba(255,255,255,0.65);font-size:11px;font-weight:700;letter-spacing:.06em;cursor:pointer;transition:all 0.15s;font-family:inherit }
.tag-preset-btn:hover,.tag-preset-btn.active { background:#fff;color:#000;border-color:#fff }
.tag-color-swatch:hover { transform:scale(1.2) !important; }
.tag-color-swatch.active { transform:scale(1.3) !important; border-color:rgba(255,255,255,0.9) !important; }
</style>
<script>
(function(){
    var hidden = document.getElementById('articleTag');
    var colorHidden = document.getElementById('articleTagColor');
    var custom = document.getElementById('articleTagCustom');
    var btns = document.querySelectorAll('.tag-preset-btn');
    var swatches = document.querySelectorAll('.tag-color-swatch');
    var preview = document.getElementById('tagColorPreview');

    function updateBtns(val){
        btns.forEach(function(b){ b.classList.toggle('active', b.textContent === val); });
    }

    function updatePreview(color){
        var fg = (color === '#ffffff' || color === '#eab308') ? '#000' : '#fff';
        preview.style.background = color;
        preview.style.color = fg;
        preview.textContent = hidden.value || 'Önizleme';
        swatches.forEach(function(s){ s.classList.toggle('active', s.dataset.color === color); });
    }

    window.selectTagColor = function(hex){
        colorHidden.value = hex;
        updatePreview(hex);
    };

    window.setArticleTag = function(val){
        hidden.value = val;
        custom.value = '';
        updateBtns(val);
        preview.textContent = val;
    };

    window.setArticleTagFromInput = function(val){
        hidden.value = val;
        updateBtns(val);
        preview.textContent = val || 'Önizleme';
    };
})();
</script>
