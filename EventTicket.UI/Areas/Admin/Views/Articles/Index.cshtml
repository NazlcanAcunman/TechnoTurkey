@model List<EventTicket.UI.ViewModels.ArticleViewModel>
@{
    ViewData["Title"] = "Makaleler";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-table-wrap">
    <div class="admin-table-header">
        <span class="admin-table-title">Makaleler (@Model.Count)</span>
        <a asp-action="Create" class="btn-admin btn-sm" style="background:#fff;color:#000">+ Yeni Makale</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div style="margin:16px 20px;background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.2);border-radius:8px;padding:10px 14px;color:#4ade80;font-size:13px">✓ @TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <div style="padding:48px;text-align:center;color:rgba(255,255,255,0.3)">Henüz makale yok.</div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Başlık</th>
                    <th>Kategori</th>
                    <th>Yazar</th>
                    <th>Tarih</th>
                    <th>Durum</th>
                    <th>İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td style="font-weight:600;max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@a.Title</td>
                        <td><span class="badge badge-info">@a.Tag</span></td>
                        <td style="color:rgba(255,255,255,0.5)">@a.Author</td>
                        <td style="color:rgba(255,255,255,0.5)">@a.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (a.IsPublished)
                            {
                                <span class="badge badge-success">Yayında</span>
                            }
                            else
                            {
                                <span class="badge badge-warning">Taslak</span>
                            }
                        </td>
                        <td>
                            <div style="display:flex;gap:6px">
                                <a asp-action="Edit" asp-route-id="@a.Id" class="btn-admin btn-sm">Düzenle</a>
                                <form asp-action="Delete" asp-route-id="@a.Id" method="post" style="display:inline"
                                      onsubmit="return confirmDelete(this, '@a.Title makalesini silmek istiyor musunuz?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-admin btn-sm btn-danger">Sil</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
