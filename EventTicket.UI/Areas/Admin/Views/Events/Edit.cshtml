@model EventTicket.UI.ViewModels.Admin.EditEventViewModel
@{
    ViewData["Title"] = "Etkinliği Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-table-wrap" style="max-width:760px">
    <div class="admin-table-header">
        <span class="admin-table-title">Düzenle — @Model.Title</span>
        <a asp-action="Index" class="btn-admin btn-sm" style="background:#444">← Geri</a>
    </div>

    <div style="padding:28px">
        @if (TempData["Success"] != null)
        {
            <div style="background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.2);border-radius:8px;
                padding:12px 16px;margin-bottom:20px;color:#4ade80;font-size:13px">✓ @TempData["Success"]</div>
        }
        @if (!ViewData.ModelState.IsValid)
        {
            <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2);border-radius:8px;
                padding:12px 16px;margin-bottom:20px;color:#f87171;font-size:13px">
                <ul style="margin:0;padding-left:16px">
                    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@err.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div style="margin-bottom:18px">
                <label class="admin-field-label">Etkinlik Başlığı *</label>
                <input asp-for="Title" class="admin-field-input" />
                <span asp-validation-for="Title" style="color:#f87171;font-size:12px"></span>
            </div>

            <div style="margin-bottom:18px">
                <label class="admin-field-label">Açıklama</label>
                <textarea asp-for="Description" class="admin-field-input" rows="3"></textarea>
            </div>

            <div style="margin-bottom:18px">
                <label class="admin-field-label">Tarih & Saat *</label>
                <input asp-for="Date" type="datetime-local" class="admin-field-input"
                       value="@Model.Date.ToString("yyyy-MM-ddTHH:mm")" />
            </div>

            <div style="margin-bottom:18px">
                <label class="admin-field-label">Görsel</label>
                <div class="upload-wrap" style="display:flex;gap:8px;align-items:center">
                    <input asp-for="ImageUrl" id="eventImageUrl" class="admin-field-input" placeholder="https://..." style="flex:1" />
                    <label class="upload-btn btn-admin btn-sm" style="cursor:pointer;white-space:nowrap;flex-shrink:0">
                        Fotoğraf Yükle
                        <input type="file" accept="image/*" style="display:none" onchange="uploadToCloudinary(this,'eventImageUrl','eventImgPreview')" />
                    </label>
                </div>
                <img id="eventImgPreview" src="@Model.ImageUrl" alt="" style="@(string.IsNullOrEmpty(Model.ImageUrl) ? "display:none;" : "")margin-top:10px;max-height:120px;border-radius:8px;object-fit:cover" />
            </div>
            <div style="margin-bottom:18px">
                <label class="admin-field-label">Bilet Satış URL</label>
                <input asp-for="TicketUrl" class="admin-field-input" placeholder="https://biletix.com/..." />
            </div>

            @* Afiş Yazısı (Badge) *@
            <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:18px;margin-bottom:18px">
                <div style="font-size:11px;font-weight:700;letter-spacing:0.1em;color:rgba(255,255,255,0.35);text-transform:uppercase;margin-bottom:14px">
                    Afiş Etiketi (Opsiyonel)
                </div>
                <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px" id="badge-presets">
                    @foreach (var preset in new[] { "HOT", "YENİ", "ÖNE ÇIKAN", "SINIRLI", "SON BİLETLER", "ÖZEL" })
                    {
                        <button type="button" class="badge-preset-btn" data-val="@preset"
                                style="background:@(Model.BadgeText == preset ? "rgba(255,255,255,0.15)" : "rgba(255,255,255,0.06)");
                                       border:1px solid @(Model.BadgeText == preset ? "rgba(255,255,255,0.5)" : "rgba(255,255,255,0.12)");
                                       border-radius:6px;color:@(Model.BadgeText == preset ? "#fff" : "rgba(255,255,255,0.65)");
                                       font-size:11px;font-weight:700;letter-spacing:0.08em;padding:5px 12px;cursor:pointer;text-transform:uppercase;transition:all 0.15s">
                            @preset
                        </button>
                    }
                    <button type="button" class="badge-preset-btn" data-val=""
                            style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:6px;
                                   color:rgba(255,255,255,0.3);font-size:11px;font-weight:700;letter-spacing:0.08em;
                                   padding:5px 12px;cursor:pointer;transition:all 0.15s">
                        × KALDIR
                    </button>
                </div>
                <div style="margin-bottom:12px">
                    <label class="admin-field-label">Özel Yazı (veya yukarıdan seç)</label>
                    <input asp-for="BadgeText" id="badge-text-input" class="admin-field-input"
                           placeholder="Örn: HOT"
                           style="text-transform:uppercase;letter-spacing:0.08em;font-weight:700" />
                </div>
                <div>
                    <label class="admin-field-label">Etiket Rengi</label>
                    @{
                        var badgeColors = new[] {
                            ("#ef4444","Kırmızı"), ("#f97316","Turuncu"), ("#eab308","Sarı"),
                            ("#22c55e","Yeşil"), ("#3b82f6","Mavi"), ("#a855f7","Mor"),
                            ("#ec4899","Pembe"), ("#ffffff","Beyaz"), ("#000000","Siyah")
                        };
                        var currentBadgeColor = string.IsNullOrEmpty(Model.BadgeColor) ? "#ef4444" : Model.BadgeColor;
                    }
                    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:6px" id="badge-color-swatches">
                        @foreach (var (hex, name) in badgeColors)
                        {
                            <button type="button" class="badge-color-swatch" data-color="@hex" title="@name"
                                    style="width:28px;height:28px;border-radius:50%;background:@hex;cursor:pointer;transition:all 0.15s;flex-shrink:0;
                                           border:@(hex == currentBadgeColor ? "2px solid rgba(255,255,255,0.8)" : "2px solid transparent");
                                           transform:@(hex == currentBadgeColor ? "scale(1.2)" : "scale(1)")"></button>
                        }
                    </div>
                    <input asp-for="BadgeColor" type="hidden" id="badge-color-input" value="@currentBadgeColor" />
                </div>
                <div id="badge-preview" style="margin-top:12px;@(string.IsNullOrEmpty(Model.BadgeText) ? "display:none" : "display:block")">
                    <span style="font-size:11px;color:rgba(255,255,255,0.35)">Önizleme: </span>
                    <span id="badge-preview-chip" style="display:inline-flex;align-items:center;font-size:11px;font-weight:800;
                          letter-spacing:0.1em;padding:4px 12px;border-radius:6px;text-transform:uppercase;
                          background:@currentBadgeColor;color:@((currentBadgeColor == "#ffffff" || currentBadgeColor == "#eab308") ? "#000" : "#fff")">
                        @(Model.BadgeText ?? "")
                    </span>
                </div>
            </div>

            @* Promosyon Kodu *@
            <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:18px;margin-bottom:18px">
                <div style="font-size:11px;font-weight:700;letter-spacing:0.1em;color:rgba(255,255,255,0.35);text-transform:uppercase;margin-bottom:14px">
                    Promosyon Kodu (Opsiyonel)
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                    <div>
                        <label class="admin-field-label">Promosyon Kodu</label>
                        <input asp-for="PromoCode" class="admin-field-input"
                               placeholder="Örn: TK10"
                               style="text-transform:uppercase;letter-spacing:0.08em;font-weight:700" />
                        <span asp-validation-for="PromoCode" style="color:#f87171;font-size:12px"></span>
                        <span style="font-size:11px;color:rgba(255,255,255,0.25);margin-top:5px;display:block">Boş bırakılırsa promosyon kaldırılır</span>
                    </div>
                    <div>
                        <label class="admin-field-label">İndirim Yüzdesi (%)</label>
                        <input asp-for="DiscountPercent" type="number" min="1" max="99" class="admin-field-input"
                               placeholder="Örn: 10" />
                        <span asp-validation-for="DiscountPercent" style="color:#f87171;font-size:12px"></span>
                    </div>
                </div>
                <div style="margin-top:14px">
                    <label class="admin-field-label">Badge Rengi</label>
                    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:6px" id="color-swatches">
                        @{
                            var colors = new[] {
                                ("#ef4444","Kırmızı"), ("#f97316","Turuncu"), ("#eab308","Sarı"),
                                ("#22c55e","Yeşil"), ("#3b82f6","Mavi"), ("#a855f7","Mor"),
                                ("#ec4899","Pembe"), ("#ffffff","Beyaz")
                            };
                            var currentColor = string.IsNullOrEmpty(Model.PromoCodeColor) ? "#ef4444" : Model.PromoCodeColor;
                        }
                        @foreach (var (hex, name) in colors)
                        {
                            <button type="button" class="color-swatch" data-color="@hex" title="@name"
                                    style="width:28px;height:28px;border-radius:50%;background:@hex;cursor:pointer;transition:all 0.15s;flex-shrink:0;border:@(hex == currentColor ? "2px solid rgba(255,255,255,0.8)" : "2px solid transparent");transform:@(hex == currentColor ? "scale(1.2)" : "scale(1)")"></button>
                        }
                    </div>
                    <input asp-for="PromoCodeColor" type="hidden" id="promo-color-input" value="@currentColor" />
                </div>
                <div id="promo-preview" style="margin-top:12px;@(string.IsNullOrEmpty(Model.PromoCode) ? "display:none" : "display:block")">
                    <span style="font-size:11px;color:rgba(255,255,255,0.35)">Önizleme: </span>
                    <span id="promo-badge" style="display:inline-flex;align-items:center;gap:6px;background:@currentColor;color:@(currentColor == "#ffffff" || currentColor == "#eab308" ? "#000" : "#fff");font-size:11px;font-weight:800;letter-spacing:0.1em;padding:4px 12px;border-radius:100px;text-transform:uppercase">
                        @(string.IsNullOrEmpty(Model.PromoCode) ? "" : (Model.DiscountPercent.HasValue ? Model.PromoCode + " — %" + Model.DiscountPercent + " İNDİRİM" : Model.PromoCode))
                    </span>
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:18px">
                <div>
                    <label class="admin-field-label">Mekan *</label>
                    <select asp-for="VenueId" class="admin-field-input">
                        @foreach (var v in Model.Venues)
                        {
                            if (v.Id == Model.VenueId)
                            {
                                <option value="@v.Id" selected>@v.Name — @v.City</option>
                            }
                            else
                            {
                                <option value="@v.Id">@v.Name — @v.City</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label class="admin-field-label">Sanatçı <span style="color:rgba(255,255,255,0.3)">(opsiyonel)</span></label>
                    <select asp-for="ArtistId" class="admin-field-input">
                        <option value="">-- Sanatçı Seçin --</option>
                        @foreach (var a in Model.Artists)
                        {
                            <option value="@a.Id" selected="@(a.Id == Model.ArtistId)">@a.Name</option>
                        }
                    </select>
                </div>
            </div>

            @* Şehir *@
            <div style="margin-bottom:18px">
                <label class="admin-field-label">Şehir</label>
                <select asp-for="City" class="admin-field-input">
                    <option value="">-- Şehir Seçin --</option>
                    @foreach (var city in new[] { "İstanbul","Ankara","İzmir","Bodrum","Çeşme","Antalya","Bursa","Alanya","Diğer" })
                    {
                        <option value="@city" selected="@(Model.City == city)">@city</option>
                    }
                </select>
            </div>

            <div style="margin-bottom:18px">
                <label style="display:flex;align-items:center;gap:10px;cursor:pointer">
                    <input asp-for="IsFeatured" type="checkbox" style="width:16px;height:16px;cursor:pointer;accent-color:#fff" />
                    <span style="font-size:12px;font-weight:700;color:rgba(255,255,255,0.7)">Öne Çıkan Etkinlik olarak işaretle</span>
                </label>
                <div style="font-size:11px;color:rgba(255,255,255,0.3);margin-top:4px;margin-left:26px">İşaretlendiğinde anasayfada "Öne Çıkan Etkinlikler" bölümünde görünür.</div>
            </div>

            <div style="display:flex;gap:10px;margin-top:8px">
                <button type="submit" class="btn-admin" style="background:#fff;color:#000">
                    ✓ Değişiklikleri Kaydet
                </button>
                <a asp-action="Index" class="btn-admin" style="background:#444">İptal</a>
            </div>
        </form>
    </div>
</div>

<style>
.admin-field-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.07em;
    color: rgba(255,255,255,0.4);
    text-transform: uppercase;
    margin-bottom: 7px;
}
.admin-field-input {
    width: 100%;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    padding: 10px 13px;
    color: #fff;
    font-size: 13px;
    font-family: inherit;
    outline: none;
    box-sizing: border-box;
}
.admin-field-input:focus { border-color: rgba(255,255,255,0.25); }
.admin-field-input option { background: #1a1a1a; }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ── Badge / Afiş Etiketi ──
        (function () {
            var textInput    = document.getElementById('badge-text-input');
            var colorInput   = document.getElementById('badge-color-input');
            var preview      = document.getElementById('badge-preview');
            var chip         = document.getElementById('badge-preview-chip');
            var swatches     = document.querySelectorAll('.badge-color-swatch');
            var presets      = document.querySelectorAll('.badge-preset-btn');

            function selectBadgeColor(hex) {
                colorInput.value = hex;
                var fg = (hex === '#ffffff' || hex === '#eab308') ? '#000' : '#fff';
                chip.style.background = hex;
                chip.style.color = fg;
                swatches.forEach(function(s) {
                    s.style.border = s.dataset.color === hex ? '2px solid rgba(255,255,255,0.8)' : '2px solid transparent';
                    s.style.transform = s.dataset.color === hex ? 'scale(1.2)' : 'scale(1)';
                });
            }

            swatches.forEach(function(s) {
                s.addEventListener('click', function() { selectBadgeColor(s.dataset.color); });
            });

            presets.forEach(function(btn) {
                btn.addEventListener('click', function() {
                    textInput.value = btn.dataset.val;
                    updateBadgePreview();
                    presets.forEach(function(b) { b.style.borderColor = 'rgba(255,255,255,0.12)'; b.style.color = 'rgba(255,255,255,0.65)'; b.style.background = 'rgba(255,255,255,0.06)'; });
                    if (btn.dataset.val) { btn.style.borderColor = 'rgba(255,255,255,0.5)'; btn.style.color = '#fff'; btn.style.background = 'rgba(255,255,255,0.15)'; }
                });
            });

            function updateBadgePreview() {
                var text = textInput.value.trim().toUpperCase();
                textInput.value = text;
                if (text) { preview.style.display = 'block'; chip.textContent = text; }
                else { preview.style.display = 'none'; }
            }

            textInput.addEventListener('input', updateBadgePreview);
        })();

        // ── Promo Kodu ──
        (function () {
            var codeInput   = document.querySelector('[name="PromoCode"]');
            var pctInput    = document.querySelector('[name="DiscountPercent"]');
            var colorInput  = document.getElementById('promo-color-input');
            var preview     = document.getElementById('promo-preview');
            var badge       = document.getElementById('promo-badge');
            var swatches    = document.querySelectorAll('.color-swatch');
            var activeColor = colorInput.value || '#ef4444';

            function selectColor(hex) {
                activeColor = hex;
                colorInput.value = hex;
                var textColor = (hex === '#ffffff' || hex === '#eab308') ? '#000' : '#fff';
                badge.style.background = hex;
                badge.style.color = textColor;
                swatches.forEach(function(s) {
                    s.style.border = s.dataset.color === hex
                        ? '2px solid rgba(255,255,255,0.8)'
                        : '2px solid transparent';
                    s.style.transform = s.dataset.color === hex ? 'scale(1.2)' : 'scale(1)';
                });
            }

            swatches.forEach(function(s) {
                s.addEventListener('click', function() { selectColor(s.dataset.color); });
            });

            function updatePreview() {
                var code = codeInput.value.trim().toUpperCase();
                var pct  = pctInput.value.trim();
                codeInput.value = code;
                if (code) {
                    preview.style.display = 'block';
                    badge.textContent = pct ? code + ' — %' + pct + ' İNDİRİM' : code;
                } else {
                    preview.style.display = 'none';
                }
            }
            codeInput.addEventListener('input', updatePreview);
            pctInput.addEventListener('input', updatePreview);
        })();
    </script>
}
