<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechnoTurkey Admin</title>
    <link rel="icon" type="image/svg+xml" href="~/icon/favicon.svg" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" />
</head>
@{
    var adminDisplayName = User.Identity?.Name ?? "";
    var adminRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    if (!string.IsNullOrEmpty(adminRole) && adminDisplayName == adminRole)
    {
        var adminEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
        adminDisplayName = adminEmail.Contains('@') ? adminEmail.Split('@')[0] : adminEmail;
    }
}
<body class="admin-body">

    <!-- SOL SIDEBAR -->
    <aside class="admin-sidebar">
        <div class="admin-sidebar-logo">
            TECHNO<span>TURKEY</span>
            <small>Admin Panel</small>
        </div>

        <nav class="admin-nav">
            <div class="admin-nav-group">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                       class="admin-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                        <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                    </svg>
                    Dashboard
                </a>
            </div>

            <div class="admin-nav-group">
                <span class="admin-nav-label">İçerik</span>
                <a asp-area="Admin" asp-controller="Events" asp-action="Index"
                       class="admin-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Events" ? "active" : "")">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2"/>
                        <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                    </svg>
                    Etkinlikler
                </a>
                <a asp-area="Admin" asp-controller="Venues" asp-action="Index"
                       class="admin-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Venues" ? "active" : "")">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        <polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                    Mekanlar
                </a>
                <a asp-area="Admin" asp-controller="Artists" asp-action="Index"
                       class="admin-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Artists" ? "active" : "")">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M9 18V5l12-2v13"/>
                        <circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>
                    </svg>
                    Sanatçılar
                </a>
                <a asp-area="Admin" asp-controller="Pending" asp-action="Index"
                       class="admin-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Pending" ? "active" : "")">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    Onay Kuyruğu
                </a>
                <a asp-area="Admin" asp-controller="Articles" asp-action="Index"
                       class="admin-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Articles" ? "active" : "")">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                    </svg>
                    Makaleler
                </a>
            </div>

            <div class="admin-nav-group">
                <span class="admin-nav-label">Kullanıcılar</span>
                <a asp-area="Admin" asp-controller="Users" asp-action="Index"
                       class="admin-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                    Kullanıcılar
                </a>
                <a asp-area="Admin" asp-controller="Messages" asp-action="Index"
                       class="admin-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Messages" ? "active" : "")">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </svg>
                    Mesajlar
                </a>
                <a asp-area="Admin" asp-controller="Guestlist" asp-action="Index"
                       class="admin-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Guestlist" ? "active" : "")">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <polyline points="16 11 18 13 22 9"/>
                    </svg>
                    Guestlist
                </a>
            </div>

            @if (adminRole == "SuperAdmin")
            {
                <div class="admin-nav-group">
                    <span class="admin-nav-label">SuperAdmin</span>
                    <a asp-area="Admin" asp-controller="Banners" asp-action="Index"
                           class="admin-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Banners" ? "active" : "")">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="5" width="18" height="14" rx="2"/>
                            <path d="M3 10h18"/>
                        </svg>
                        Bannerlar
                    </a>
                    <a asp-area="Admin" asp-controller="Notifications" asp-action="Index"
                           class="admin-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Notifications" ? "active" : "")">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                        </svg>
                        Bildirimler
                    </a>
                    <a asp-area="Admin" asp-controller="Academy" asp-action="Index"
                           class="admin-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Academy" ? "active" : "")">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                            <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                        </svg>
                        Akademi
                    </a>
                    <a asp-area="Admin" asp-controller="Settings" asp-action="Index"
                           class="admin-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="3"/>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                        </svg>
                        Ayarlar
                    </a>
                </div>
            }
        </nav>

        <div class="admin-sidebar-footer">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="admin-back-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 12H5" />
                    <path d="M12 19l-7-7 7-7" />
                </svg>
                Siteye Dön
            </a>
            <a asp-area="" asp-controller="Auth" asp-action="Logout" class="admin-logout-btn">Çıkış Yap</a>
        </div>
    </aside>

    <!-- MOBİL BACKDROP -->
    <div class="admin-backdrop" id="adminBackdrop" onclick="closeSidebar()"></div>

    <!-- SAĞ İÇERİK -->
    <div class="admin-content">
        <header class="admin-header">
            <div style="display:flex;align-items:center;gap:14px">
                <button class="admin-hamburger" id="adminHamburger" onclick="toggleSidebar()" aria-label="Menü">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
                <h1 class="admin-page-title">@ViewData["Title"]</h1>
            </div>
            <div class="admin-header-right">
                <span class="admin-user">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    <span class="admin-user-name">@adminDisplayName</span>
                </span>
            </div>
        </header>

        <main class="admin-main">
            @RenderBody()
        </main>
    </div>

    <!-- Silme Onay Modalı -->
    <div id="deleteModal" style="
        display:none; position:fixed; inset:0; z-index:9999;
        background:rgba(0,0,0,0.7); backdrop-filter:blur(4px);
        align-items:center; justify-content:center;">
        <div style="
            background:#1a1a1a; border:1px solid rgba(255,255,255,0.1);
            border-radius:16px; padding:32px; max-width:420px; width:90%;
            box-shadow:0 40px 80px rgba(0,0,0,0.6);">
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:20px">
                <div style="width:44px;height:44px;border-radius:50%;background:rgba(239,68,68,0.12);
                    border:1px solid rgba(239,68,68,0.25);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2">
                        <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                        <path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/>
                    </svg>
                </div>
                <div>
                    <div style="font-size:15px;font-weight:700;color:#fff;margin-bottom:4px">Silmek istediğinize emin misiniz?</div>
                    <div id="deleteModalDesc" style="font-size:13px;color:rgba(255,255,255,0.4)">Bu işlem geri alınamaz.</div>
                </div>
            </div>
            <div style="display:flex;gap:10px;justify-content:flex-end">
                <button onclick="closeDeleteModal()"
                    style="padding:9px 20px;border-radius:8px;border:1px solid rgba(255,255,255,0.12);
                        background:rgba(255,255,255,0.05);color:rgba(255,255,255,0.7);font-size:13px;
                        font-weight:600;cursor:pointer;font-family:inherit">
                    İptal
                </button>
                <button id="deleteModalConfirm"
                    style="padding:9px 20px;border-radius:8px;border:none;
                        background:#ef4444;color:#fff;font-size:13px;
                        font-weight:700;cursor:pointer;font-family:inherit">
                    Evet, Sil
                </button>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            document.body.classList.toggle('sidebar-open');
        }
        function closeSidebar() {
            document.body.classList.remove('sidebar-open');
        }
        // Mobilde nav linkine tıklayınca sidebar kapansın
        document.querySelectorAll('.admin-nav-item').forEach(function(el) {
            el.addEventListener('click', function() {
                if (window.innerWidth < 768) closeSidebar();
            });
        });

        var _pendingDeleteForm = null;

        function confirmDelete(formEl, desc) {
            _pendingDeleteForm = formEl;
            document.getElementById('deleteModalDesc').textContent = desc || 'Bu işlem geri alınamaz.';
            document.getElementById('deleteModal').style.display = 'flex';
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').style.display = 'none';
            _pendingDeleteForm = null;
        }

        document.getElementById('deleteModalConfirm').addEventListener('click', function () {
            if (_pendingDeleteForm) _pendingDeleteForm.submit();
        });

        document.getElementById('deleteModal').addEventListener('click', function (e) {
            if (e.target === this) closeDeleteModal();
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- ── Cropper Modal ── -->
    <div id="cropperModal" style="display:none;position:fixed;inset:0;z-index:99999;background:rgba(0,0,0,0.88);align-items:center;justify-content:center;">
        <div style="background:#111;border:1px solid rgba(255,255,255,0.1);border-radius:18px;padding:24px;width:min(820px,96vw);max-height:93vh;display:flex;flex-direction:column;gap:16px">
            <div style="display:flex;justify-content:space-between;align-items:center">
                <span style="color:#fff;font-size:15px;font-weight:700">Fotoğrafı Ayarla</span>
                <button onclick="closeCropper()" style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);border-radius:8px;padding:6px 14px;color:rgba(255,255,255,0.7);cursor:pointer;font-family:inherit;font-size:13px">✕ Kapat</button>
            </div>
            <div style="flex:1;overflow:hidden;border-radius:10px;background:#000;max-height:58vh">
                <img id="cropperImage" style="max-width:100%;display:block" />
            </div>
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                <button onclick="cropperInstance.zoom(0.1)"  style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);border-radius:8px;padding:7px 16px;color:#fff;cursor:pointer;font-family:inherit;font-size:13px;font-weight:700">+ Büyüt</button>
                <button onclick="cropperInstance.zoom(-0.1)" style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);border-radius:8px;padding:7px 16px;color:#fff;cursor:pointer;font-family:inherit;font-size:13px;font-weight:700">− Küçült</button>
                <button onclick="cropperInstance.rotate(-90)" style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);border-radius:8px;padding:7px 14px;color:#fff;cursor:pointer;font-family:inherit;font-size:13px">↺ Sol</button>
                <button onclick="cropperInstance.rotate(90)"  style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);border-radius:8px;padding:7px 14px;color:#fff;cursor:pointer;font-family:inherit;font-size:13px">↻ Sağ</button>
                <button onclick="cropperInstance.reset()"    style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);border-radius:8px;padding:7px 14px;color:rgba(255,255,255,0.5);cursor:pointer;font-family:inherit;font-size:12px">Sıfırla</button>
                <button id="cropperConfirmBtn" onclick="confirmCrop()" style="margin-left:auto;background:#fff;color:#000;border:none;border-radius:8px;padding:9px 22px;font-weight:800;font-size:13px;cursor:pointer;font-family:inherit">✓ Kırp ve Yükle</button>
            </div>
            <div style="font-size:11px;color:rgba(255,255,255,0.25)">Kırp kutusunu sürükleyerek konumlandır · Sürükle ile kaydır · Scroll ile zoom yap</div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
    <script>
        const CLOUDINARY_CLOUD = 'dqwhpi0ue';
        const CLOUDINARY_PRESET = 'technoturkey_uploads';

        let cropperInstance = null;
        let cropperCtx = null;

        function uploadToCloudinary(inputEl, targetId, previewId) {
            const file = inputEl.files[0];
            if (!file) return;
            const btn = inputEl.closest('.upload-wrap')?.querySelector('.upload-btn');
            if (btn) { btn.textContent = 'Hazırlanıyor...'; btn.disabled = true; }

            const reader = new FileReader();
            reader.onload = (e) => {
                const img = document.getElementById('cropperImage');
                img.src = e.target.result;
                if (cropperInstance) { cropperInstance.destroy(); cropperInstance = null; }
                document.getElementById('cropperModal').style.display = 'flex';
                setTimeout(() => {
                    cropperInstance = new Cropper(img, {
                        viewMode: 1,
                        dragMode: 'move',
                        autoCropArea: 1,
                        restore: false,
                        guides: true,
                        center: true,
                        highlight: false,
                        cropBoxMovable: true,
                        cropBoxResizable: true,
                        toggleDragModeOnDblclick: false,
                        wheelZoomRatio: 0.1,
                    });
                }, 50);
                cropperCtx = { targetId, previewId, btn };
                const confirmBtn = document.getElementById('cropperConfirmBtn');
                if (confirmBtn) { confirmBtn.textContent = '✓ Kırp ve Yükle'; confirmBtn.disabled = false; }
            };
            reader.readAsDataURL(file);
        }

        function closeCropper() {
            document.getElementById('cropperModal').style.display = 'none';
            if (cropperInstance) { cropperInstance.destroy(); cropperInstance = null; }
            if (cropperCtx?.btn) { cropperCtx.btn.textContent = 'Fotoğraf Yükle'; cropperCtx.btn.disabled = false; cropperCtx.btn.style.background = ''; }
            cropperCtx = null;
        }

        async function confirmCrop() {
            if (!cropperInstance || !cropperCtx) return;
            const { targetId, previewId, btn } = cropperCtx;
            const confirmBtn = document.getElementById('cropperConfirmBtn');
            if (confirmBtn) { confirmBtn.textContent = 'Yükleniyor...'; confirmBtn.disabled = true; }

            const canvas = cropperInstance.getCroppedCanvas({ maxWidth: 2400, maxHeight: 2400, imageSmoothingQuality: 'high' });
            canvas.toBlob(async (blob) => {
                const formData = new FormData();
                formData.append('file', blob, 'image.jpg');
                formData.append('upload_preset', CLOUDINARY_PRESET);
                try {
                    const res = await fetch(`https://api.cloudinary.com/v1_1/${CLOUDINARY_CLOUD}/image/upload`, { method: 'POST', body: formData });
                    const data = await res.json();
                    if (data.secure_url) {
                        document.getElementById(targetId).value = data.secure_url;
                        if (previewId) {
                            const prev = document.getElementById(previewId);
                            if (prev) { prev.src = data.secure_url; prev.style.display = 'block'; }
                        }
                        if (btn) { btn.textContent = '✓ Yüklendi'; btn.style.background = '#22c55e'; btn.style.color = '#000'; btn.disabled = false; }
                        document.getElementById('cropperModal').style.display = 'none';
                        if (cropperInstance) { cropperInstance.destroy(); cropperInstance = null; }
                        cropperCtx = null;
                    } else {
                        if (btn) { btn.textContent = 'Hata!'; btn.style.background = '#ef4444'; btn.disabled = false; }
                        if (confirmBtn) { confirmBtn.textContent = '✓ Kırp ve Yükle'; confirmBtn.disabled = false; }
                    }
                } catch {
                    if (btn) { btn.textContent = 'Hata!'; btn.style.background = '#ef4444'; btn.disabled = false; }
                    if (confirmBtn) { confirmBtn.textContent = '✓ Kırp ve Yükle'; confirmBtn.disabled = false; }
                }
            }, 'image/jpeg', 0.92);
        }
    </script>
</body>
</html>
