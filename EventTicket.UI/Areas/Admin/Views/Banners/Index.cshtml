@model List<EventTicket.UI.ViewModels.BannerViewModel>
@using EventTicket.Core.Entities
@{
    ViewData["Title"] = "Bannerlar";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-table-wrap">
    <div class="admin-table-header">
        <span class="admin-table-title">Tüm Bannerlar (@Model.Count)</span>
        <a asp-action="Create" class="btn-admin" style="background:#6c5ce7">+ Yeni Banner</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div style="background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.2);border-radius:8px;
            padding:12px 16px;margin:16px 16px 0;color:#4ade80;font-size:13px">&#x2713; @TempData["Success"]</div>
    }

    @if (Model.Any())
    {
        <table>
            <thead>
                <tr>
                    <th>Sıra</th>
                    <th>Tür</th>
                    <th>Başlık</th>
                    <th>Alt Başlık</th>
                    <th>Tarih / Mekan</th>
                    <th>Durum</th>
                    <th>İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.OrderBy(x => x.SortOrder))
                {
                    <tr>
                        <td style="color:rgba(255,255,255,0.5);font-variant-numeric:tabular-nums">@b.SortOrder</td>
                        <td>
                            @if (b.Type == BannerType.HeroSlide)
                            {
                                <span class="badge" style="background:rgba(99,102,241,0.15);color:#818cf8;border:1px solid rgba(99,102,241,0.25)">Hero Slider</span>
                            }
                            else
                            {
                                <span class="badge" style="background:rgba(34,197,94,0.12);color:#4ade80;border:1px solid rgba(34,197,94,0.2)">Öne Çıkan</span>
                            }
                        </td>
                        <td style="font-weight:600">@b.Title</td>
                        <td style="color:rgba(255,255,255,0.45);font-size:12px">@b.SubTitle</td>
                        <td style="color:rgba(255,255,255,0.4);font-size:12px">
                            @if (!string.IsNullOrEmpty(b.DateText))
                            {
                                <span>@b.DateText</span>
                            }
                            @if (!string.IsNullOrEmpty(b.Venue))
                            {
                                <span> &middot; @b.Venue</span>
                            }
                        </td>
                        <td>
                            @if (b.IsActive)
                            {
                                <span class="badge badge-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge badge-warning">Pasif</span>
                            }
                        </td>
                        <td>
                            <div style="display:flex;gap:6px;flex-wrap:wrap">
                                <a asp-action="Edit" asp-route-id="@b.Id"
                                   class="btn-admin btn-sm" style="background:#2d6a4f">
                                    Düzenle
                                </a>
                                <form asp-action="Delete" method="post" style="margin:0" class="delete-form">
                                    <input type="hidden" name="id" value="@b.Id" />
                                    <button type="button" class="btn-admin btn-danger btn-sm"
                                            onclick="confirmDelete(this.closest('form'), '@b.Title silinecek. Emin misiniz?')">
                                        Sil
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p style="padding:24px;color:rgba(255,255,255,0.4)">Henüz banner yok.</p>
    }
</div>
